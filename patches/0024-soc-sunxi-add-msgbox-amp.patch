@@ -0,0 +1,694 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * sunxi_msgbox_amp.c - Allwinner H713 Msgbox AMP driver
+ *
+ * RE from stock H713 vmlinux (IDA Pro 9.1):
+ *   sunxi_msgbox_probe     @ 0xc07db360
+ *   sunxi_msgbox_irq       @ 0xc07dacc0
+ *   sunxi_rpmsg_edp_send   @ 0xc07dabec
+ *   sunxi_rpmsg_create_ept @ 0xc07db108
+ *   sx_base                @ 0xc07dabc8
+ *   sx_read_irq_enable     @ 0xc07daab8
+ *   sx_write_irq_disable   @ 0xc07daaf0
+ *
+ * Hardware: H713 Msgbox v2 (version 0x00020000)
+ *   3 user regions (ARM=0, MIPS=1, User2=2), each 0x400 bytes in DTS.
+ *   Per-user block = 256 bytes per remote peer.
+ *   Register offsets within a user*peer block:
+ *     +0x20: RX IRQ enable  (BIT(2*port) per port)
+ *     +0x24: RX IRQ status  (W1C)
+ *     +0x30: TX IRQ enable  (BIT(2*port+1) per port)
+ *     +0x34: TX IRQ status  (W1C)
+ *     +0x60: FIFO count     (per-port: +4*port)
+ *     +0x70: MSG data       (per-port: +4*port, auto-pop read / push write)
+ *     +0x80: TX init/reset  (per-port: +4*port, write 0 to clear)
+ *
+ * DTS: compatible = "sunxi,msgbox-amp"
+ *   reg = <User0 0x400 User1 0x400 User2 0x400>;
+ *   interrupts = <SPI46 SPI109 SPI108>;
+ *   clocks/resets for bus-msgbox
+ *   msgbox_amp_counts, msgbox_amp_local, rpmsg-id, rpmsg-N-{amp,src,dst}
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/clk.h>
+#include <linux/reset.h>
+#include <linux/interrupt.h>
+#include <linux/of_irq.h>
+#include <linux/rpmsg.h>
+#include "../../../rpmsg/rpmsg_internal.h"
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/completion.h>
+#include <linux/list.h>
+#include <linux/delay.h>
+
+#define DRIVER_NAME		"sunxi-msgbox-amp"
+#define MAX_USERS		5
+#define USER_STRIDE		256
+
+#define REG_IRQ_EN		0x20
+#define REG_IRQ_STAT		0x24
+#define REG_IRQ_EN2		0x30
+#define REG_IRQ_STAT2		0x34
+#define REG_FIFO_STAT		0x60
+#define REG_MSG_DATA		0x70
+#define REG_TX_INIT		0x80
+#define FIFO_MAX		8
+
+#define RX_IRQ_BIT(p)		BIT(2 * (p))
+#define TX_IRQ_BIT(p)		BIT(2 * (p) + 1)
+
+/* Stock timeout: 0xEA6 jiffies = ~37.5s @ HZ=100 */
+#define TX_TIMEOUT_MS		6000
+
+struct sx_endpoint {
+	struct list_head	node;
+	struct rpmsg_endpoint	ept;
+	struct sx_msgbox_dev	*mdev;
+	/* Stock field order at ept offsets 100/104/108/112 */
+	int			remote;
+	int			local;
+	int			rx_port;
+	int			tx_port;
+	struct mutex		tx_lock;
+	struct completion	tx_done;
+	void			*tx_data;
+	int			tx_len;
+	int			tx_pos;
+};
+
+struct sx_rpmsg_dev {
+	struct rpmsg_device	rpdev;
+	struct sx_msgbox_dev	*mdev;
+	struct list_head	node;
+	struct list_head	endpoints;
+	int			amp_idx;
+	int			src_port;
+	int			dst_port;
+};
+
+struct sx_msgbox_dev {
+	struct platform_device	*pdev;
+	struct list_head	rpmsg_devs;
+	struct clk		*clk;
+	struct reset_control	*rst;
+	raw_spinlock_t		lock;
+	void __iomem		*base[MAX_USERS];
+	int			num_bases;
+	int			*irqs;
+	int			num_irqs;
+	int			amp_cnt;
+	int			amp_cur;
+};
+
+/* -- Register helpers (exact stock match) -- */
+
+static void __iomem *sx_base(struct sx_msgbox_dev *mdev, int i)
+{
+	if (WARN_ON(i >= mdev->num_bases || !mdev->base[i]))
+		return NULL;
+	return mdev->base[i];
+}
+
+/*
+ * adj(l, r): stock formula for choosing the sub-block within a user region.
+ * Each user region has (amp_cnt - 1) sub-blocks of 256 bytes, one per peer.
+ * The sub-block index skips the user's own index.
+ */
+static inline int adj(int l, int r)
+{
+	return (l < r) ? r - 1 : r;
+}
+
+/*
+ * Stock sx_read_irq_enable @ 0xc07daab8:
+ *   Called as: sx_read_irq_enable(sx_base(mdev, R), R, L, port)
+ *   reg = base[R] + 256 * adj(R, L) + 0x20
+ *   Sets BIT(2*port) = RX IRQ enable
+ */
+static void sx_rx_irq_set(void __iomem *base, int l, int r, int p, bool en)
+{
+	void __iomem *reg = base + USER_STRIDE * adj(l, r) + REG_IRQ_EN;
+	u32 val = readl(reg);
+	dsb(sy);
+	if (en)
+		val |= RX_IRQ_BIT(p);
+	else
+		val &= ~RX_IRQ_BIT(p);
+	dsb(st);
+	writel(val, reg);
+}
+
+/*
+ * Stock sx_write_irq_disable @ 0xc07daaf0:
+ *   Called as: sx_write_irq_disable(sx_base(mdev, R), L, R, port)
+ *   reg = base[R] + 256 * ((R < L) ? L-1 : L) + 0x30
+ *   Clears BIT(2*port+1) = TX IRQ disable
+ */
+static void sx_tx_irq_set(void __iomem *base, int l, int r, int p, bool en)
+{
+	int a = (r < l) ? l - 1 : l;
+	void __iomem *reg = base + USER_STRIDE * a + REG_IRQ_EN2;
+	u32 val = readl(reg);
+	dsb(sy);
+	if (en)
+		val |= TX_IRQ_BIT(p);
+	else
+		val &= ~TX_IRQ_BIT(p);
+	dsb(st);
+	writel(val, reg);
+}
+
+/* -- RPMSG endpoint ops -- */
+
+static struct sx_endpoint *to_sx(struct rpmsg_endpoint *ept)
+{
+	return container_of(ept, struct sx_endpoint, ept);
+}
+
+/*
+ * TX send: write data to MIPS's User2 FIFO and return.
+ *
+ * H713 msgbox v2 hardware findings (RE + empirical testing):
+ *
+ * 1. Stock driver writes TX IRQ Enable at User0+0x30 as doorbell.
+ *    On H713, User0+0x30 is WRITE-PROTECTED for ARM. Blocked.
+ *
+ * 2. ARM CAN write TX IRQ Enable at User1+0x30 and User2+0x30.
+ *    User1 TX Enable generates GIC SPI108 IRQs (ARM-side only),
+ *    but does NOT set User2 RX Status → no MIPS notification.
+ *
+ * 3. Writing to User2 FIFO (0x03003874) DOES set User2 RX Status
+ *    BIT(2), which is the condition for MIPS RX IRQ. This is the
+ *    correct doorbell on H713.
+ *
+ * 4. MIPS IRQ handler reads FIFO from User2 region (type=2 in
+ *    endpoint struct → offset +0x800 from msgbox base).
+ *
+ * Strategy: write data directly to User2 FIFO (not User1).
+ * The FIFO write itself sets U2 RX Status which should trigger
+ * MIPS interrupt (pending MIPS INTC investigation — see handoff).
+ *
+ * TODO: MIPS INTC at 0x03061300 might need additional config.
+ *       See HANDOFF-IPC-SESSION-20260416-B.md for details.
+ */
+/*
+ * sx_ept_send — HYBRID PATTERN (pre-fill + sticky + completion-wait)
+ *
+ * Pure stock-style sticky-only doesn't fire TX_IRQ on H713 — HW seems
+ * edge-triggered (TX_IRQ_STAT only set on FIFO drain transition, not on
+ * EN-bit set with empty FIFO). Hybrid:
+ *   1. Pre-fill all payload bytes into FIFO (4-byte chunks)
+ *   2. Set TX_IRQ_EN sticky — ARISC sees "ARM has data, may have more"
+ *      while drain runs. Important: bit STAYS SET during drain (vs old
+ *      pulse pattern which cleared 10us after — broke ARISC framing).
+ *   3. Block in wait_for_completion_timeout
+ *   4. ARISC drains FIFO → HW transitions empty → TX_IRQ_STAT fires
+ *   5. IRQ-handler sees tx_pos == tx_len → disables TX_IRQ_EN + complete()
+ *
+ * This combines old pre-fill (which worked for byte transport) with stock
+ * sticky-bit semantics (which ARISC firmware expects for clean framing).
+ */
+static int sx_ept_send(struct rpmsg_endpoint *ept, void *data, int len)
+{
+	struct sx_endpoint *sx = to_sx(ept);
+	struct sx_msgbox_dev *mdev = sx->mdev;
+	void __iomem *bR;
+	int tw_R, pos = 0;
+	unsigned long flags;
+	long ret;
+
+	bR = sx_base(mdev, sx->remote);
+	if (!bR)
+		return -ENODEV;
+
+	tw_R = (sx->local < sx->remote) ? sx->remote - 1 : sx->remote;
+
+	mutex_lock(&sx->tx_lock);
+
+	/* Setup TX state for IRQ-handler to see "all bytes already pre-filled" */
+	raw_spin_lock_irqsave(&mdev->lock, flags);
+	sx->tx_data = data;
+	sx->tx_len = len;
+	sx->tx_pos = len;	/* tx_pos = tx_len so IRQ-handler triggers completion immediately */
+	reinit_completion(&sx->tx_done);
+	raw_spin_unlock_irqrestore(&mdev->lock, flags);
+
+	/* Pre-fill FIFO with payload (synchronous, 4-byte chunks LE-packed) */
+	while (pos < len) {
+		u32 word = 0;
+		int b;
+
+		for (b = 0; b < 32 && pos < len; b += 8)
+			word |= (u32)((u8 *)data)[pos++] << b;
+		dsb(st);
+		writel(word, bR + USER_STRIDE * tw_R +
+		       REG_MSG_DATA + 4 * sx->tx_port);
+	}
+
+	/* Set TX_IRQ_EN STICKY — ARISC sees "data ready" until drain done.
+	 * Bit cleared by IRQ-handler when TX_IRQ_STAT fires + tx_pos == tx_len. */
+	{
+		void __iomem *reg = bR + USER_STRIDE * tw_R + REG_IRQ_EN2;
+		u32 val = readl(reg);
+		dsb(sy);
+		val |= TX_IRQ_BIT(sx->tx_port);
+		dsb(st);
+		writel(val, reg);
+		dsb(sy);
+	}
+
+	pr_info_ratelimited("sx_ept_send: L=%d R=%d tx_port=%d len=%d (hybrid-sticky)\n",
+			    sx->local, sx->remote, sx->tx_port, len);
+
+	/* Block until IRQ-handler signals completion (or timeout) */
+	ret = wait_for_completion_timeout(&sx->tx_done,
+					  msecs_to_jiffies(TX_TIMEOUT_MS));
+
+	if (ret == 0) {
+		raw_spin_lock_irqsave(&mdev->lock, flags);
+		sx_tx_irq_set(bR, sx->local, sx->remote, sx->tx_port, false);
+		pr_warn("sx_ept_send: timeout L=%d R=%d port=%d len=%d\n",
+			sx->local, sx->remote, sx->tx_port, len);
+		raw_spin_unlock_irqrestore(&mdev->lock, flags);
+		mutex_unlock(&sx->tx_lock);
+		return -ETIMEDOUT;
+	}
+
+	mutex_unlock(&sx->tx_lock);
+	return 0;
+}
+
+static void sx_ept_destroy(struct rpmsg_endpoint *ept)
+{
+	struct sx_endpoint *sx = to_sx(ept);
+	void __iomem *bR = sx_base(sx->mdev, sx->remote);
+
+	if (bR)
+		sx_rx_irq_set(bR, sx->remote, sx->local, sx->rx_port, false);
+	list_del(&sx->node);
+	kfree(sx);
+}
+
+static const struct rpmsg_endpoint_ops sx_ep_ops = {
+	.destroy_ept	= sx_ept_destroy,
+	.send		= sx_ept_send,
+};
+
+/* -- RPMSG device ops -- */
+
+static struct rpmsg_endpoint *sx_create_ept(
+	struct rpmsg_device *rpdev,
+	rpmsg_rx_cb_t cb, void *priv,
+	struct rpmsg_channel_info chinfo)
+{
+	struct sx_rpmsg_dev *srd = container_of(rpdev, struct sx_rpmsg_dev, rpdev);
+	struct sx_msgbox_dev *mdev = srd->mdev;
+	struct sx_endpoint *sx;
+	void __iomem *bR;
+	int R = srd->amp_idx;
+	int L = mdev->amp_cur;
+	int tw_adj;
+
+	sx = devm_kzalloc(&mdev->pdev->dev, sizeof(*sx), GFP_KERNEL);
+	if (!sx)
+		return NULL;
+
+	sx->mdev = mdev;
+	sx->remote = R;
+	sx->local = L;
+	sx->rx_port = srd->dst_port;
+	sx->tx_port = srd->src_port;
+	sx->ept.rpdev = rpdev;
+	sx->ept.cb = cb;
+	sx->ept.priv = priv;
+	sx->ept.ops = &sx_ep_ops;
+	kref_init(&sx->ept.refcount);
+	mutex_init(&sx->tx_lock);
+	init_completion(&sx->tx_done);
+
+	list_add(&sx->node, &srd->endpoints);
+
+	bR = sx_base(mdev, R);
+	if (!bR)
+		return &sx->ept;
+
+	/* Stock create_ept: write 0 to REG_TX_INIT to reset TX counter.
+	 * Register at base[R] + 256 * adj3 + 0x80 + 4*tx_port
+	 * where adj3 = (L <= R) ? L : L-1 */
+	tw_adj = (L <= R) ? L : L - 1;
+	dsb(st);
+	writel(0, bR + USER_STRIDE * tw_adj + REG_TX_INIT + 4 * sx->tx_port);
+
+	/* Enable RX IRQ in OWN region (base[L]).
+	 * HW enforces: IRQ enable only writable in own user region.
+	 * Stock writes to base[R] but that doesn't work on H713. */
+	{
+		void __iomem *bL = sx_base(mdev, L);
+		if (bL)
+			sx_rx_irq_set(bL, L, R, sx->rx_port, true);
+	}
+
+	dev_info(&mdev->pdev->dev, "ept: R=%d L=%d rx=%d tx=%d\n",
+		 R, L, sx->rx_port, sx->tx_port);
+	return &sx->ept;
+}
+
+static const struct rpmsg_device_ops sx_rpdev_ops = {
+	.create_ept = sx_create_ept,
+};
+
+/* -- IRQ handler (stock @ 0xc07dacc0) -- */
+
+static irqreturn_t sunxi_msgbox_irq(int irq, void *data)
+{
+	struct sx_msgbox_dev *mdev = data;
+	struct sx_rpmsg_dev *srd;
+	struct sx_endpoint *sx;
+	unsigned long flags;
+	u32 msg;
+	bool work_done = false;	/* IRQF_SHARED-etiquette: only HANDLED if we did work */
+
+	raw_spin_lock_irqsave(&mdev->lock, flags);
+
+	list_for_each_entry(srd, &mdev->rpmsg_devs, node) {
+	  list_for_each_entry(sx, &srd->endpoints, node) {
+		int R = sx->remote;
+		int L = sx->local;
+		int rxp = sx->rx_port;
+		int txp = sx->tx_port;
+		void __iomem *bR = sx_base(mdev, R);
+		void __iomem *bL = sx_base(mdev, L);
+		int ra, ta, twa;
+		u32 en, st;
+
+		if (!bR || !bL)
+			continue;
+
+		/*
+		 * RX: all regs at base[L] + 256*ra + offset (H713 FIX 2026-04-24).
+		 * Stock sunxi_msgbox_irq at 0xc07dacc0 uses base[v7=LOCAL] with
+		 * ra = (v7>=v8) ? v8 : v8-1 = adj(L, R). The prior port used
+		 * base[REMOTE] / adj(R, L) which produced the ARM→MIPS TX address
+		 * (0x3003874) for RX — a loopback bug that silently hid because
+		 * no rpmsg_device was probed yet. Empirically MIPS writes at
+		 * User0 sub-block 1 = 0x3003174 (base[L=0] + 1*256 + 0x74) per
+		 * session-K observation.
+		 */
+		ra = (L >= R) ? R : R - 1;
+
+		en = readl(bL + USER_STRIDE * ra + REG_IRQ_EN);
+		dsb(sy);
+		if (en & RX_IRQ_BIT(rxp)) {
+			st = readl(bL + USER_STRIDE * ra + REG_IRQ_STAT);
+			dsb(sy);
+			if (st & RX_IRQ_BIT(rxp)) {
+				work_done = true;	/* OUR IRQ */
+				while (readl(bL + USER_STRIDE * ra +
+					     REG_FIFO_STAT + 4 * rxp)) {
+					dsb(sy);
+					msg = readl(bL + USER_STRIDE * ra +
+						    REG_MSG_DATA + 4 * rxp);
+					dsb(sy);
+					if (sx->ept.cb)
+						sx->ept.cb(sx->ept.rpdev,
+							   &msg, 4,
+							   sx->ept.priv,
+							   L);
+				}
+				dsb(sy); /* stock: dsb(st) */
+				writel(RX_IRQ_BIT(rxp),
+				       bL + USER_STRIDE * ra + REG_IRQ_STAT);
+			}
+		}
+
+		/* TX flow-control branch (stock pattern @ 0xc07dad94+) — kept
+		 * enabled but largely no-op with current pulse-workaround send.
+		 * Will fire if/when HW sets TX_IRQ_STAT bit (~40% on H713 due to
+		 * race). Harmless when send is fire-and-forget pulse pattern.
+		 *
+		 * TODO post-P3: revisit with mainline-clean send pattern. */
+		{
+			int tw_R = (L < R) ? R - 1 : R;	/* adj(L,R) */
+			void __iomem *tx_en_r = bR + USER_STRIDE * tw_R + REG_IRQ_EN2;
+			void __iomem *tx_st_r = bR + USER_STRIDE * tw_R + REG_IRQ_STAT2;
+			void __iomem *fifo_r  = bR + USER_STRIDE * tw_R + REG_FIFO_STAT + 4 * txp;
+			void __iomem *data_r  = bR + USER_STRIDE * tw_R + REG_MSG_DATA + 4 * txp;
+			u32 tx_bit = TX_IRQ_BIT(txp);
+			u32 tx_en, tx_st, fifo_lvl, word;
+			int b;
+
+			tx_en = readl(tx_en_r);
+			dsb(sy);
+			if (tx_en & tx_bit) {
+				tx_st = readl(tx_st_r);
+				dsb(sy);
+				if (tx_st & tx_bit) {
+					work_done = true;
+
+					while (1) {
+						fifo_lvl = readl(fifo_r);
+						dsb(sy);
+						/* Stock: break when FIFO_STAT == 8 (full).
+						 * FIFO_MAX is the depth; can't push more. */
+						if (fifo_lvl >= FIFO_MAX)
+							break;
+
+						if (sx->tx_pos >= sx->tx_len) {
+							/* Done — clear doorbell + signal completion */
+							sx_tx_irq_set(bR, L, R, txp, false);
+							complete(&sx->tx_done);
+							break;
+						}
+
+						/* Build u32 from tx_data, advance tx_pos */
+						word = 0;
+						for (b = 0; b < 32 && sx->tx_pos < sx->tx_len; b += 8) {
+							word |= (u32)((u8 *)sx->tx_data)[sx->tx_pos++] << b;
+						}
+						dsb(st);
+						arm_heavy_mb();
+						writel(word, data_r);
+					}
+
+					/* W1C TX_IRQ_STAT — ack the IRQ */
+					dsb(st);
+					writel(tx_bit, tx_st_r);
+				}
+			}
+			(void)ta; (void)twa; (void)en; (void)st;
+		}
+	  }
+	}
+
+	raw_spin_unlock_irqrestore(&mdev->lock, flags);
+	return work_done ? IRQ_HANDLED : IRQ_NONE;
+}
+
+/* -- Probe -- */
+
+static int sunxi_msgbox_probe(struct platform_device *pdev)
+{
+	struct sx_msgbox_dev *mdev;
+	struct resource *res;
+	int i, ret;
+	u32 amp_cnt = 2, amp_local = 0;
+	int nch;
+
+	mdev = devm_kzalloc(&pdev->dev, sizeof(*mdev), GFP_KERNEL);
+	if (!mdev)
+		return -ENOMEM;
+
+	mdev->pdev = pdev;
+	platform_set_drvdata(pdev, mdev);
+	INIT_LIST_HEAD(&mdev->rpmsg_devs);
+	raw_spin_lock_init(&mdev->lock);
+
+	for (i = 0; i < MAX_USERS; i++) {
+		res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!res)
+			break;
+		mdev->base[i] = devm_ioremap_resource(&pdev->dev, res);
+		if (IS_ERR(mdev->base[i])) {
+			if (i == 0)
+				return PTR_ERR(mdev->base[i]);
+			mdev->base[i] = NULL;
+			break;
+		}
+	}
+	mdev->num_bases = i;
+
+	mdev->clk = of_clk_get(pdev->dev.of_node, 0);
+	if (!IS_ERR(mdev->clk))
+		clk_prepare_enable(mdev->clk);
+	else
+		mdev->clk = NULL;
+
+	/* SHARED, not exclusive: cpu_comm.c also claims the same reset
+	 * as devm_reset_control_get_optional_shared(). Must match to coexist. */
+	mdev->rst = devm_reset_control_get_optional_shared(&pdev->dev, NULL);
+	if (!IS_ERR_OR_NULL(mdev->rst))
+		reset_control_deassert(mdev->rst);
+
+	mdev->num_irqs = of_irq_count(pdev->dev.of_node);
+	if (mdev->num_irqs > 0) {
+		mdev->irqs = devm_kcalloc(&pdev->dev, mdev->num_irqs,
+					  sizeof(int), GFP_KERNEL);
+		for (i = 0; i < mdev->num_irqs; i++) {
+			mdev->irqs[i] = of_irq_get(pdev->dev.of_node, i);
+			if (mdev->irqs[i] < 0)
+				return mdev->irqs[i];
+		}
+	}
+
+	of_property_read_u32(pdev->dev.of_node, "msgbox_amp_counts", &amp_cnt);
+	of_property_read_u32(pdev->dev.of_node, "msgbox_amp_local", &amp_local);
+	mdev->amp_cnt = amp_cnt;
+	mdev->amp_cur = amp_local;
+
+	if (amp_local >= amp_cnt) {
+		dev_err(&pdev->dev, "local %d >= count %d\n", amp_local, amp_cnt);
+		return -EINVAL;
+	}
+
+	/* Stock H713 DTS naming convention (verified against extracted hy310-board.dts):
+	 *   rpmsg_id            (string list, one per channel)
+	 *   rpmsg_amp_remote-N  (u32: remote amp index for channel N)
+	 *   rpmsg_read_channel-N  (u32: rx port for channel N)
+	 *   rpmsg_write_channel-N (u32: tx port for channel N) */
+	nch = of_property_count_strings(pdev->dev.of_node, "rpmsg_id");
+	for (i = 0; i < nch; i++) {
+		const char *name;
+		u32 ch_amp = 0, ch_src = 0, ch_dst = 0;
+		struct sx_rpmsg_dev *srd;
+		char prop[32];
+
+		of_property_read_string_index(pdev->dev.of_node, "rpmsg_id",
+					      i, &name);
+		snprintf(prop, sizeof(prop), "rpmsg_amp_remote-%d", i);
+		of_property_read_u32(pdev->dev.of_node, prop, &ch_amp);
+		snprintf(prop, sizeof(prop), "rpmsg_read_channel-%d", i);
+		of_property_read_u32(pdev->dev.of_node, prop, &ch_src);
+		snprintf(prop, sizeof(prop), "rpmsg_write_channel-%d", i);
+		of_property_read_u32(pdev->dev.of_node, prop, &ch_dst);
+
+		if (ch_amp >= amp_cnt || ch_src > 3 || ch_dst > 3) {
+			dev_warn(&pdev->dev, "skip %s\n", name);
+			continue;
+		}
+
+		srd = devm_kzalloc(&pdev->dev, sizeof(*srd), GFP_KERNEL);
+		if (!srd)
+			continue;
+
+		srd->mdev = mdev;
+		srd->amp_idx = ch_amp;
+		srd->src_port = ch_src;
+		srd->dst_port = ch_dst;
+		srd->rpdev.ops = &sx_rpdev_ops;
+		srd->rpdev.dev.parent = &pdev->dev;
+		srd->rpdev.src = ch_src | (amp_local << 8);
+		srd->rpdev.dst = ch_dst | (ch_amp << 8);
+		INIT_LIST_HEAD(&srd->endpoints);
+		strncpy(srd->rpdev.id.name, name, RPMSG_NAME_SIZE - 1);
+
+		ret = rpmsg_register_device(&srd->rpdev);
+		if (ret) {
+			devm_kfree(&pdev->dev, srd);
+			continue;
+		}
+		list_add(&srd->node, &mdev->rpmsg_devs);
+		dev_info(&pdev->dev, "rpmsg: %s amp=%d src=%d dst=%d\n",
+			 name, ch_amp, ch_src, ch_dst);
+	}
+
+	for (i = 0; i < mdev->num_irqs; i++) {
+		/* IRQF_SHARED: cpu_comm shares IRQ 345 (USER0 RX) with us — both
+		 * treiber listen on the same line, each handler returns IRQ_NONE
+		 * for events not addressed to it. */
+		ret = devm_request_irq(&pdev->dev, mdev->irqs[i],
+				       sunxi_msgbox_irq, IRQF_SHARED,
+				       dev_name(&pdev->dev), mdev);
+		if (ret) {
+			dev_err(&pdev->dev, "IRQ %d failed: %d\n",
+				mdev->irqs[i], ret);
+			return ret;
+		}
+	}
+
+	dev_info(&pdev->dev, "probed: %d bases, %d IRQs, %d ch, amp=%d/%d\n",
+		 mdev->num_bases, mdev->num_irqs, nch, amp_local, amp_cnt);
+	return 0;
+}
+
+static void sunxi_msgbox_remove(struct platform_device *pdev)
+{
+	struct sx_msgbox_dev *mdev = platform_get_drvdata(pdev);
+	int i;
+
+	for (i = 0; i < mdev->num_irqs; i++)
+		disable_irq(mdev->irqs[i]);
+	device_for_each_child(&pdev->dev, NULL,
+		(int (*)(struct device *, void *))device_unregister);
+}
+
+static int sunxi_msgbox_suspend(struct device *dev)
+{
+	return 0;
+}
+
+static int sunxi_msgbox_resume(struct device *dev)
+{
+	struct sx_msgbox_dev *mdev = dev_get_drvdata(dev);
+	struct sx_rpmsg_dev *srd;
+	struct sx_endpoint *sx;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&mdev->lock, flags);
+	list_for_each_entry(srd, &mdev->rpmsg_devs, node) {
+		list_for_each_entry(sx, &srd->endpoints, node) {
+			void __iomem *bR = sx_base(mdev, sx->remote);
+			int tw = (sx->local <= sx->remote) ?
+				 sx->local : sx->local - 1;
+
+			if (!bR)
+				continue;
+			dsb(st);
+			writel(0, bR + USER_STRIDE * tw +
+			       REG_TX_INIT + 4 * sx->tx_port);
+			sx_rx_irq_set(bR, sx->remote, sx->local,
+				      sx->rx_port, true);
+		}
+	}
+	raw_spin_unlock_irqrestore(&mdev->lock, flags);
+	return 0;
+}
+
+static const struct dev_pm_ops sunxi_msgbox_pm = {
+	.suspend = sunxi_msgbox_suspend,
+	.resume  = sunxi_msgbox_resume,
+};
+
+static const struct of_device_id sunxi_msgbox_ids[] = {
+	{ .compatible = "sunxi,msgbox-amp" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sunxi_msgbox_ids);
+
+static struct platform_driver sunxi_msgbox_drv = {
+	.probe	= sunxi_msgbox_probe,
+	.remove	= sunxi_msgbox_remove,
+	.driver	= {
+		.name		= DRIVER_NAME,
+		.of_match_table	= sunxi_msgbox_ids,
+		.pm		= &sunxi_msgbox_pm,
+	},
+};
+module_platform_driver(sunxi_msgbox_drv);
+
+MODULE_DESCRIPTION("Allwinner H713 Msgbox AMP (RE from stock)");
+MODULE_LICENSE("GPL");
