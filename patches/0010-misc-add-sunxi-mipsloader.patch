+}
+static DEVICE_ATTR_RO(communication_errors);
+
+/**
+ * validate_keystone_params - Validate keystone parameter ranges
+ * @params: Keystone parameters to validate
+ * 
+ * Returns 0 on success, negative error code on failure
+ */
+static int validate_keystone_params(struct keystone_params *params)
+{
+	if (abs(params->tl_x) > MAX_KEYSTONE_X ||
+	    abs(params->tl_y) > MAX_KEYSTONE_Y ||
+	    abs(params->tr_x) > MAX_KEYSTONE_X ||
+	    abs(params->tr_y) > MAX_KEYSTONE_Y ||
+	    abs(params->bl_x) > MAX_KEYSTONE_X ||
+	    abs(params->bl_y) > MAX_KEYSTONE_Y ||
+	    abs(params->br_x) > MAX_KEYSTONE_X ||
+	    abs(params->br_y) > MAX_KEYSTONE_Y) {
+		return -ERANGE;
+	}
+	
+	return 0;
+}
+
+/**
+ * mips_wait_cmd_complete - Wait for MIPS command completion
+ * @timeout_ms: Timeout in milliseconds
+ * 
+ * Returns 0 on success, -ETIMEDOUT on timeout
+ */
+static int mips_wait_cmd_complete(unsigned long timeout_ms)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(timeout_ms);
+	u32 status;
+	
+	while (time_before(jiffies, timeout)) {
+		status = mipsloader_reg_read(MIPS_REG_STATUS);
+		if (!(status & 0x1))
+			return 0;
+		msleep(10);
+	}
+	
+	return -ETIMEDOUT;
+}
+
+/**
+ * mips_set_keystone_params - Send keystone parameters to MIPS processor
+ * @params: Keystone parameters to set
+ * 
+ * Returns 0 on success, negative error code on failure
+ */
+static int mips_set_keystone_params(struct keystone_params *params)
+{
+	int ret;
+	void __iomem *config_addr;
+	
+	if (!mipsloader_dev || !mipsloader_dev->mem_base) {
+		pr_err("mipsloader: Device not initialized\n");
+		return -ENODEV;
+	}
+	
+	if (!mipsloader_dev->firmware_loaded) {
+		dev_warn(&mipsloader_dev->pdev->dev, 
+			 "Firmware not loaded, keystone parameters may not take effect\n");
+	}
+	
+	ret = validate_keystone_params(params);
+	if (ret) {
+		dev_err(&mipsloader_dev->pdev->dev, 
+			"Invalid keystone parameters: values out of range\n");
+		return ret;
+	}
+	
+	config_addr = mipsloader_dev->mem_base + (MIPS_TSE_ADDR - MIPS_BOOT_CODE_ADDR);
+	memcpy_toio(config_addr, params, sizeof(*params));
+	
+	mipsloader_reg_write(MIPS_REG_CMD, MIPS_CMD_UPDATE_KEYSTONE);
+	
+	ret = mips_wait_cmd_complete(MIPS_CMD_TIMEOUT_MS);
+	if (ret) {
+		dev_err(&mipsloader_dev->pdev->dev, 
+			"MIPS keystone update timeout\n");
+		atomic64_inc(&mipsloader_dev->metrics.communication_errors);
+		return ret;
+	}
+	
+	mipsloader_dev->keystone = *params;
+	
+	dev_info(&mipsloader_dev->pdev->dev, 
+		 "Keystone parameters updated: tl(%d,%d) tr(%d,%d) bl(%d,%d) br(%d,%d)\n",
+		 params->tl_x, params->tl_y, params->tr_x, params->tr_y,
+		 params->bl_x, params->bl_y, params->br_x, params->br_y);
+	
+	return 0;
+}
+
+/**
+ * panelparam_show - Read current keystone correction parameters
+ */
+static ssize_t panelparam_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	if (!mipsloader_dev)
+		return -ENODEV;
+	
+	return sprintf(buf, "tl_x=%d,tl_y=%d,tr_x=%d,tr_y=%d,bl_x=%d,bl_y=%d,br_x=%d,br_y=%d\n",
+		       mipsloader_dev->keystone.tl_x, mipsloader_dev->keystone.tl_y,
+		       mipsloader_dev->keystone.tr_x, mipsloader_dev->keystone.tr_y,
+		       mipsloader_dev->keystone.bl_x, mipsloader_dev->keystone.bl_y,
+		       mipsloader_dev->keystone.br_x, mipsloader_dev->keystone.br_y);
+}
+
+/**
+ * panelparam_store - Write keystone correction parameters
+ */
+static ssize_t panelparam_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct keystone_params params;
+	int ret;
+	
+	if (!mipsloader_dev)
+		return -ENODEV;
+	
+	ret = sscanf(buf, "tl_x=%d,tl_y=%d,tr_x=%d,tr_y=%d,bl_x=%d,bl_y=%d,br_x=%d,br_y=%d",
+		     &params.tl_x, &params.tl_y,
+		     &params.tr_x, &params.tr_y,
+		     &params.bl_x, &params.bl_y,
+		     &params.br_x, &params.br_y);
+	
+	if (ret != 8) {
+		dev_err(dev, "Invalid keystone parameter format. Expected: tl_x=N,tl_y=N,...\n");
+		return -EINVAL;
+	}
+	
+	ret = mips_set_keystone_params(&params);
+	if (ret)
+		return ret;
+	
+	return count;
+}
+
+static DEVICE_ATTR_RW(panelparam);
+
+/* ── MIPS Elog Full Capture ─────────────────────────────────── */
+
+/*
+ * Live grep-scan: watch new MIPS elog bytes for key phrases and
+ * surface them to kernel log so we don't need to dump elog_full
+ * manually. Matches across chunk boundaries via small rolling window.
+ */
+#define ELOG_SCAN_WINDOW 64  /* back-extend window for cross-chunk matches */
+static char elog_scan_tail[ELOG_SCAN_WINDOW];
+static size_t elog_scan_tail_len;
+
+static const char * const elog_watch_patterns[] = {
+	"Init Done",
+	"sunxi_cpu_comm_init return",
+	"End cpu_comm ini",
+	"msgbox hardware version",
+	"msgbox fifo garbage",
+	"CPUFlag[CPU_COMM_MASTER]",
+	"THal_Vp_Wce",
+	"magic code incorrect",
+	"ShStartAddr=0x0, size=0x0",
+	"ShStartAddr=0x4e",
+	"CPU is not master",
+	"InitFlag1",
+	"setCPUAppReady",
+	NULL
+};
+
+static void elog_scan_chunk(const char *data, size_t len);
+
+/* HY310-fix 2026-04-19: dedup ring to suppress repeated MIPS-EVENT spam.
+ * Stores hashes of recently emitted lines; if hash already seen, skip. */
+#define ELOG_DEDUP_SIZE 32
+static u32 elog_dedup_ring[ELOG_DEDUP_SIZE];
+static u32 elog_dedup_idx;
+
+/* djb2, skipping anything between [..] brackets (MIPS tick counters) and
+ * skipping individual decimal digits outside brackets (stray counters).
+ * This makes "(msgbox.c 100)msgbox fifo garbage size: 00000000" hash the
+ * same as "(msgbox.c 100)msgbox fifo garbage size: 00000001" — the semantic
+ * content is what matters for dedup, not the per-call numbers. */
+static inline u32 elog_line_hash(const char *s)
+{
+	u32 h = 5381;
+	int in_bracket = 0;
+	for (; *s; s++) {
+		char c = *s;
+		if (c == '[') { in_bracket = 1; continue; }
+		if (c == ']') { in_bracket = 0; continue; }
+		if (in_bracket) continue;
+		if (c >= '0' && c <= '9') continue;	/* skip digits */
+		h = ((h << 5) + h) ^ (u8)c;
+	}
+	return h ? h : 1;
+}
+
+static bool elog_dedup_seen(u32 h)
+{
+	int i;
+	for (i = 0; i < ELOG_DEDUP_SIZE; i++)
+		if (elog_dedup_ring[i] == h)
+			return true;
+	elog_dedup_ring[elog_dedup_idx] = h;
+	elog_dedup_idx = (elog_dedup_idx + 1) % ELOG_DEDUP_SIZE;
+	return false;
+}
+
+static void elog_live_scan(const char *data, size_t len)
+{
+	/* Process data in 1 KB windows so we don't miss matches in big
+	 * chunks (ring buffer wrap can deliver >100 KB at once). */
+	const size_t WIN = 1024;
+	size_t off = 0;
+	while (off < len) {
+		size_t chunk = (len - off > WIN) ? WIN : (len - off);
+		elog_scan_chunk(data + off, chunk);
+		off += chunk;
+	}
+}
+
+static void elog_scan_chunk(const char *data, size_t len)
+{
+	size_t buf_len;
+	char scan_buf[ELOG_SCAN_WINDOW + 1024 + 1];  /* window + chunk + NUL */
+	const char *const *pat;
+	size_t i, copy_len;
+
+	/* Build scan buffer: previous tail + current chunk */
+	copy_len = len;
+	if (elog_scan_tail_len + copy_len > sizeof(scan_buf) - 1)
+		copy_len = sizeof(scan_buf) - 1 - elog_scan_tail_len;
+	memcpy(scan_buf, elog_scan_tail, elog_scan_tail_len);
+	memcpy(scan_buf + elog_scan_tail_len, data, copy_len);
+	buf_len = elog_scan_tail_len + copy_len;
+	scan_buf[buf_len] = '\0';
+
+	/* Search each pattern; print surrounding line on match */
+	for (pat = elog_watch_patterns; *pat; pat++) {
+		const char *p = scan_buf;
+		while ((p = strstr(p, *pat)) != NULL) {
+			/* Find line start (previous \n or buffer start) */
+			const char *ls = p;
+			const char *le;
+			char line[160];
+			size_t ln;
+
+			while (ls > scan_buf && *(ls - 1) != '\n')
+				ls--;
+			/* Find line end */
+			le = p;
+			while (le < scan_buf + buf_len && *le != '\n' && *le != '\0')
+				le++;
+			ln = le - ls;
+			if (ln > sizeof(line) - 1)
+				ln = sizeof(line) - 1;
+			memcpy(line, ls, ln);
+			line[ln] = '\0';
+			/* Strip ANSI CSI escapes (ESC [ ... letter). Final byte is
+			 * an alphabetic char (A-Z or a-z), NOT '[' itself. */
+			{
+				char clean[160];
+				size_t ci = 0;
+				int esc_state = 0; /* 0 normal, 1 saw ESC, 2 in CSI */
+				for (i = 0; i < ln && ci < sizeof(clean) - 1; i++) {
+					char c = line[i];
+					if (esc_state == 0) {
+						if (c == 0x1b) { esc_state = 1; continue; }
+						if (c >= 0x20 && c < 0x7f)
+							clean[ci++] = c;
+						continue;
+					}
+					if (esc_state == 1) {
+						esc_state = (c == '[') ? 2 : 0;
+						continue;
+					}
+					/* esc_state == 2 */
+					if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'))
+						esc_state = 0;
+					continue;
+				}
+				clean[ci] = '\0';
+				/* HY310-fix 2026-04-19: skip if already shown recently */
+				if (ci > 0 && !elog_dedup_seen(elog_line_hash(clean)))
+					pr_info("mipsloader: MIPS-EVENT: %s\n", clean);
+			}
+			p += strlen(*pat);
+		}
+	}
+
+	/* Save tail for cross-chunk matching next call */
+	if (len < ELOG_SCAN_WINDOW) {
+		elog_scan_tail_len = len;
+		memcpy(elog_scan_tail, data, len);
+	} else {
+		elog_scan_tail_len = ELOG_SCAN_WINDOW;
+		memcpy(elog_scan_tail, data + len - ELOG_SCAN_WINDOW, ELOG_SCAN_WINDOW);
+	}
+}
+
+/*
+ * HY310-fix 2026-04-19c: generic line dedup for the capture buffer.
+ *
+ * MIPS spams many repeated lines that fill the 64MB buffer in seconds:
+ *   - "ShStartAddr=0x0, size=0x0" from trid_smm.c:1141 (early boot wait)
+ *   - "%s - %s ready [NNNN]" from comm_request.c:917 (timer tick)
+ *   - likely others we haven't seen yet
+ *
+ * We dedup using a digit-stripped FNV-1a hash (so variable counters like
+ * [1234] hash to the same value as [5678]). First occurrence of each
+ * unique pattern passes through; subsequent matches are dropped.
+ *
+ * Ring size 256 = up to 256 distinct patterns remembered before oldest
+ * is displaced. Large enough for typical MIPS debug diversity.
+ */
+#define ELOG_APPEND_DEDUP_SIZE 256
+static u32 elog_append_dedup_ring[ELOG_APPEND_DEDUP_SIZE];
+static u32 elog_append_dedup_idx;
+
+/* Length-limited variant of elog_line_hash. Skips digits + whitespace
+ * + trailing line terminators so "[1234]" hashes same as "[5678]". */
+static u32 elog_line_hash_n(const char *s, size_t len)
+{
+	u32 h = 2166136261u;		/* FNV-1a basis */
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		char c = s[i];
+
+		if (c == '\n' || c == '\r')
+			continue;
+		if (c >= '0' && c <= '9')
+			continue;
+		h = (h ^ (unsigned char)c) * 16777619u;
+	}
+	return h;
+}
+
+/* Returns true if this hash has been seen before (i.e. this is a
+ * repeat line that should be dropped). Side-effect: adds the hash to
+ * the ring if not seen. */
+static bool elog_append_dedup_seen(u32 h)
+{
+	int i;
+
+	for (i = 0; i < ELOG_APPEND_DEDUP_SIZE; i++) {
+		if (elog_append_dedup_ring[i] == h)
+			return true;
+	}
+	elog_append_dedup_ring[elog_append_dedup_idx] = h;
+	elog_append_dedup_idx = (elog_append_dedup_idx + 1) % ELOG_APPEND_DEDUP_SIZE;
+	return false;
+}
+
+/* Raw bytes → ring buffer with wrap-around. elog_wp is monotonic
+ * (never resets); physical write position is elog_wp % SIZE. When
+ * elog_wp exceeds SIZE we've wrapped and oldest bytes are being
+ * overwritten — readers see a sliding window of the last SIZE bytes. */
+static void elog_emit_raw(const char *data, size_t len)
+{
+	if (!elog_linear || !len)
+		return;
+
+	while (len) {
+		size_t pos = elog_wp % ELOG_CAPTURE_SIZE;
+		size_t chunk = ELOG_CAPTURE_SIZE - pos;
+
+		if (chunk > len)
+			chunk = len;
+		memcpy(elog_linear + pos, data, chunk);
+		data += chunk;
+		len -= chunk;
+		elog_wp += chunk;
+	}
+}
+
+/*
+ * Append new bytes from the ring buffer to the linear output.
+ * Called with elog_lock held.
+ *
+ * Processes line-by-line. Each complete line is hashed (digit-stripped)
+ * and skipped if already seen. Trailing partial line is emitted as-is.
+ */
+static void elog_append(const char *data, size_t len)
+{
+	const char *p = data;
+	size_t remaining = len;
+
+	/* Live scan for key events (always, even if linear buffer full) */
+	elog_live_scan(data, len);
+
+	if (elog_full || !elog_linear)
+		return;
+
+	while (remaining) {
+		const char *nl = memchr(p, '\n', remaining);
+		size_t line_len;
+		u32 h;
+
+		if (nl) {
+			line_len = (nl - p) + 1;  /* include the '\n' */
+		} else {
+			/* Partial trailing line — pass through uncapped.
+			 * Next chunk's leading bytes complete this line
+			 * but will get their own hash-check when followed
+			 * by a '\n'. Minor imperfection, not critical. */
+			elog_emit_raw(p, remaining);
+			return;
+		}
+
+		/* HY310-fix 2026-04-19e: dedup disabled — ring buffer handles
+		 * overflow naturally. Previous aggressive digit-strip dedup
+		 * collapsed too many distinct info/warn messages whose only
+		 * variation was a counter/timestamp. With the 64MB ring, we
+		 * simply accept all bytes; oldest get overwritten eventually. */
+		(void)elog_line_hash_n;
+		(void)elog_append_dedup_seen;
+		(void)h;
+		elog_emit_raw(p, line_len);
+
+		p += line_len;
+		remaining -= line_len;
+	}
+}
+
+/* HY310-fix 2026-04-19: elog_find_end / elog_diff_and_append removed.
+ * Position-based reader in elog_thread_fn uses MIPS's own write pointer
+ * instead of content-snapshot diffs. */
+
+/*
+ * HY310-fix 2026-04-19: position-based elog reader using MIPS write pointers.
+ *
+ * Per-poll: read wp from elog_ctl and copy delta from source buffer into
+ * our linear capture. Works for both Mode 1 (ring at 0x4B272D9C, 100KB
+ * with wrap) and Mode 2 (linear at 0x4B28BD9C, 2MB no wrap).
+ */
+static int elog_thread_fn(void *data)
+{
+	void __iomem *ring_base;
+	void __iomem *linear_base;
+	u8 mode;
+
+	if (!mipsloader_dev || !mipsloader_dev->mem_base)
+		return -ENODEV;
+
+	ring_base   = mipsloader_dev->mem_base + ELOG_RING_OFF;
+	linear_base = mipsloader_dev->mem_base + ELOG_LINEAR_OFF;
+
+	if (!elog_ctl_vaddr) {
+		pr_warn("mipsloader: elog_ctl not mapped, elog thread exit\n");
+		return -ENODEV;
+	}
+
+	mode = readb(elog_ctl_vaddr + ELOG_MODE_OFF);
+	pr_info("mipsloader: elog capture started (mode=%u, %uMB linear out)\n",
+		mode, ELOG_CAPTURE_SIZE / (1024 * 1024));
+
+	/* Initialize last-known write pointer to current MIPS wp so that on
+	 * first poll we emit everything already written. Start at 0 for
+	 * linear, or at 0 for ring — both mean "copy all existing data." */
+	mutex_lock(&elog_lock);
+	elog_last_wp_src = 0;
+	elog_last_wrap   = 0;
+	mutex_unlock(&elog_lock);
+
+	while (!kthread_should_stop()) {
+		msleep(ELOG_POLL_MS);
+
+		if (elog_full)
+			continue;
+
+		mode = readb(elog_ctl_vaddr + ELOG_MODE_OFF);
+
+		if (mode == 2) {
+			/* Mode 2 linear: just delta */
+			u32 cur_wp2 = readl(elog_ctl_vaddr + ELOG_WP2_OFF);
+			u32 bytes_new;
+
+			if (cur_wp2 == elog_last_wp_src)
+				continue;
+
+			if (cur_wp2 > ELOG_LINEAR_BUF_SIZE) {
+				pr_warn_once(
+				 "mipsloader: wp2=%u > buf %u — capped\n",
+				 cur_wp2, ELOG_LINEAR_BUF_SIZE);
+				cur_wp2 = ELOG_LINEAR_BUF_SIZE;
+			}
+			if (cur_wp2 < elog_last_wp_src) {
+				/* MIPS linear would not normally go backward —
+				 * could mean firmware restart. Reset and emit
+				 * all from 0. */
+				elog_last_wp_src = 0;
+			}
+			bytes_new = cur_wp2 - elog_last_wp_src;
+			if (bytes_new == 0)
+				continue;
+
+			mutex_lock(&elog_lock);
+			{
+				char *tmp = kmalloc(bytes_new, GFP_KERNEL);
+				if (tmp) {
+					memcpy_fromio(tmp,
+						linear_base + elog_last_wp_src,
+						bytes_new);
+					elog_append(tmp, bytes_new);
+					kfree(tmp);
+				}
+			}
+			elog_last_wp_src = cur_wp2;
+
+			/*
+			 * HY310-fix 2026-04-19: cycle wp2 when near the 2MB cap.
+			 * Mode 2 is linear and MIPS stops writing once wp2=SIZE.
+			 * We reset wp2=0 so MIPS continues writing from offset 0
+			 * for another 2MB cycle. We've already copied the last
+			 * cycle to our 16MB linear, so resetting doesn't lose data.
+			 * This lets us accumulate multiple 2MB cycles — full
+			 * bootlog + runtime in our capture buffer.
+			 */
+			if (cur_wp2 >= ELOG_LINEAR_BUF_SIZE - 64) {
+				writel(0, elog_ctl_vaddr + ELOG_WP2_OFF);
+				elog_last_wp_src = 0;
+				pr_info_ratelimited(
+				 "mipsloader: wp2 cycled (2MB captured, reset to 0)\n");
+			}
+			mutex_unlock(&elog_lock);
+		} else {
+			/* Mode 1 ring: use wp + wrap tracking */
+			u32 cur_wp   = readl(elog_ctl_vaddr + ELOG_WP1_OFF);
+			u8  cur_wrap = readb(elog_ctl_vaddr + ELOG_WRAP1_OFF);
+			u32 wp_idx   = cur_wp % ELOG_RING_SIZE;
+			u32 last_idx = elog_last_wp_src % ELOG_RING_SIZE;
+
+			if (wp_idx == last_idx && cur_wrap == elog_last_wrap)
+				continue;
+
+			mutex_lock(&elog_lock);
+			{
+				char *tmp;
+				if (cur_wrap == elog_last_wrap && wp_idx > last_idx) {
+					u32 n = wp_idx - last_idx;
+					tmp = kmalloc(n, GFP_KERNEL);
+					if (tmp) {
+						memcpy_fromio(tmp,
+							ring_base + last_idx, n);
+						elog_append(tmp, n);
+						kfree(tmp);
+					}
+				} else {
+					/* wrap happened */
+					u32 n1 = ELOG_RING_SIZE - last_idx;
+					u32 n2 = wp_idx;
+					tmp = kmalloc(n1 + n2, GFP_KERNEL);
+					if (tmp) {
+						memcpy_fromio(tmp,
+							ring_base + last_idx, n1);
+						memcpy_fromio(tmp + n1,
+							ring_base, n2);
+						elog_append(tmp, n1 + n2);
+						kfree(tmp);
+					}
+				}
+			}
+			elog_last_wp_src = cur_wp;
+			elog_last_wrap   = cur_wrap;
+			mutex_unlock(&elog_lock);
+		}
+	}
+
+	return 0;
+}
+
+/* sysfs bin_attribute: /sys/class/hy300/mips/elog_full
+ *
+ * HY310-fix 2026-04-19d: ring-buffer read. elog_wp is monotonic; the
+ * valid range in the ring is:
+ *   - if wp <= SIZE: [0..wp)  (not yet wrapped, linear read)
+ *   - if wp >  SIZE: last SIZE bytes, i.e. the sliding window
+ *                    starting at ring position (wp % SIZE), which is
+ *                    also the OLDEST byte still in the ring.
+ * The exposed virtual view to userspace is always contiguous:
+ *   virt offset 0 = oldest byte
+ *   virt offset (available-1) = newest byte
+ * where available = min(wp, SIZE).
+ */
+static ssize_t elog_full_read(struct file *filp, struct kobject *kobj,
+			      const struct bin_attribute *attr,
+			      char *buf, loff_t off, size_t count)
+{
+	size_t wp, available, start, pos, first_chunk;
+
+	mutex_lock(&elog_lock);
+	wp = elog_wp;
+	mutex_unlock(&elog_lock);
+
+	if (wp == 0)
+		return 0;
+
+	available = (wp < ELOG_CAPTURE_SIZE) ? wp : ELOG_CAPTURE_SIZE;
+	if ((size_t)off >= available)
+		return 0;
+	if (off + count > available)
+		count = available - off;
+
+	/* Not yet wrapped: linear read from offset 0. */
+	if (wp <= ELOG_CAPTURE_SIZE) {
+		memcpy(buf, elog_linear + off, count);
+		return count;
+	}
+
+	/* Wrapped: oldest byte is at ring position (wp % SIZE). */
+	start = wp % ELOG_CAPTURE_SIZE;
+	pos = (start + off) % ELOG_CAPTURE_SIZE;
+	first_chunk = ELOG_CAPTURE_SIZE - pos;
+
+	if (count <= first_chunk) {
+		memcpy(buf, elog_linear + pos, count);
+	} else {
+		memcpy(buf, elog_linear + pos, first_chunk);
+		memcpy(buf + first_chunk, elog_linear, count - first_chunk);
+	}
+	return count;
+}
+
+static const struct bin_attribute bin_attr_elog_full = {
+	.attr  = { .name = "elog_full", .mode = 0444 },
+	.size  = ELOG_CAPTURE_SIZE,
+	.read_new = elog_full_read,
+};
+
+static const struct bin_attribute *const mipsloader_bin_attrs[] = {
+	&bin_attr_elog_full,
+	NULL,
+};
+
+static struct attribute *mipsloader_attrs[] = {
+	&dev_attr_memory_stats.attr,
+	&dev_attr_register_access_count.attr,
+	&dev_attr_firmware_status.attr,
+	&dev_attr_communication_errors.attr,
+	&dev_attr_panelparam.attr,
+	NULL,
+};
+static const struct attribute_group mipsloader_group = {
+	.attrs		= mipsloader_attrs,
+	.bin_attrs_new	= mipsloader_bin_attrs,
+};
+
+static const struct attribute_group *mipsloader_groups[] = {
+	&mipsloader_group,
+	NULL,
+};
+
+/**
+ * mipsloader_probe - Platform device probe
+ */
+static int mipsloader_probe(struct platform_device *pdev)
+{
+	struct resource *res;
+	int ret;
+	int i;
+	dev_t devt;
+	struct clk *bus_clk, *mips_clk;
+
+	dev_info(&pdev->dev, "Probing MIPS loader device\n");
+
+	/* CRITICAL: Claim MIPS clocks IMMEDIATELY so the clock framework
+	 * cannot gate them. U-Boot enabled these clocks, but Linux sees
+	 * them as "unused" because no driver has claimed them yet.
+	 * If the clock framework gates BUS_MIPS_CLK before we get here,
+	 * the MIPS control block loses its register contents and MIPS
+	 * reboots with ShStartAddr=0x0.
+	 */
+	bus_clk = devm_clk_get_enabled(&pdev->dev, "bus-clk");
+	if (IS_ERR(bus_clk)) {
+		dev_warn(&pdev->dev, "failed to get bus-clk: %ld\n", PTR_ERR(bus_clk));
+		bus_clk = NULL;
+	} else {
+		dev_info(&pdev->dev, "BUS_MIPS_CLK claimed and enabled\n");
+	}
+
+	mips_clk = devm_clk_get_enabled(&pdev->dev, "mips-clk");
+	if (IS_ERR(mips_clk)) {
+		dev_warn(&pdev->dev, "failed to get mips-clk: %ld\n", PTR_ERR(mips_clk));
+		mips_clk = NULL;
+	} else {
+		dev_info(&pdev->dev, "MIPS_CLK claimed and enabled (rate=%luHz)\n",
+			 clk_get_rate(mips_clk));
+	}
+
+	/* Allocate device structure */
+	mipsloader_dev = devm_kzalloc(&pdev->dev, sizeof(*mipsloader_dev), GFP_KERNEL);
+	if (!mipsloader_dev)
+		return -ENOMEM;
+	
+	mipsloader_dev->pdev = pdev;
+	mutex_init(&mipsloader_dev->lock);
+	platform_set_drvdata(pdev, mipsloader_dev);
+	
+	/* Initialize metrics */
+	memset(&mipsloader_dev->metrics, 0, sizeof(mipsloader_dev->metrics));
+	for (i = 0; i < 4; i++)
+		atomic64_set(&mipsloader_dev->metrics.reg_access_count[i], 0);
+	
+	memset(&mipsloader_dev->keystone, 0, sizeof(mipsloader_dev->keystone));
+	
+	/* Map register region */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res) {
+		dev_err(&pdev->dev, "No register resource found\n");
+		return -ENOENT;
+	}
+	
+	mipsloader_dev->reg_base = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(mipsloader_dev->reg_base)) {
+		dev_err(&pdev->dev, "Failed to map registers\n");
+		return PTR_ERR(mipsloader_dev->reg_base);
+	}
+	
+	dev_info(&pdev->dev, "Register base mapped to %p\n", mipsloader_dev->reg_base);
+
+	/* CRITICAL FIX: Ensure MIPS clocks are enabled and write
+	 * share registers. DO NOT pulse reset — the share registers are
+	 * in the same reset domain as the MIPS core and get cleared to 0x0
+	 * when reset is asserted.
+	 *
+	 * If MIPS already booted (from U-Boot) and read share regs as 0x0
+	 * (because kernel clock framework gated BUS_MIPS_CLK), this write
+	 * gives MIPS a chance to re-read them via doorbell from cpu_comm.
+	 */
+	{
+		void __iomem *ccu;
+		u32 val;
+
+		ccu = ioremap(0x02001000, 0x800);
+		if (ccu) {
+			/* Read current CCU state for debugging */
+			val = readl(ccu + 0x600);
+			dev_info(&pdev->dev, "CCU MIPS CLK: 0x%08x\n", val);
+			val = readl(ccu + 0x60c);
+			dev_info(&pdev->dev, "CCU BUS_MIPS GATE+RESET: 0x%08x\n", val);
+
+			/* Ensure bus gate is ON */
+			val = readl(ccu + 0x60c);
+			val |= 0x1;
+			writel(val, ccu + 0x60c);
+
+			/* Ensure MIPS clock is ON */
+			val = readl(ccu + 0x600);
+			val |= 0x80000000;
+			writel(val, ccu + 0x600);
+
+			/* MSGBOX reset deassert */
+			val = readl(ccu + 0x71c);
+			val |= 0x00010000;
+			writel(val, ccu + 0x71c);
+
+			/* Write share regs — NO reset pulse! */
+			writel(CPU_COMM_SHMEM_ADDR, mipsloader_dev->reg_base + SHARE_REG_ADDR_OFF);
+			writel(CPU_COMM_SHMEM_SIZE, mipsloader_dev->reg_base + SHARE_REG_SIZE_OFF);
+
+			/* Verify */
+			val = readl(mipsloader_dev->reg_base + SHARE_REG_ADDR_OFF);
+			dev_info(&pdev->dev, "Share regs AFTER write: addr=0x%x (expect 0x%x)\n",
+				val, CPU_COMM_SHMEM_ADDR);
+
+			msleep(100);
+
+			/* Verify again — should still hold since no reset */
+			val = readl(mipsloader_dev->reg_base + SHARE_REG_ADDR_OFF);
+			dev_info(&pdev->dev, "Share regs after 100ms: addr=0x%x\n", val);
+
+			iounmap(ccu);
+		} else {
+			dev_warn(&pdev->dev, "failed to ioremap CCU\n");
+		}
+	}
+
+	/*
+	 * Clear NOTICE_REQ (bit 3) on the MIPS CPU-flag word in shared memory.
+	 *
+	 * Context: U-Boot released MIPS long before Linux loaded. DDR content
+	 * at shmem+0x4CE0 (MIPS flag) may be cold-boot noise — e.g. 0xDF00FFFF
+	 * — whose low byte has bit 3 set. MIPS's main loop polls its own flag
+	 * and treats bit 3 as an outstanding "reset notice", spamming
+	 * "Wait CPUNoticeReqed" at every tick (~1 kHz) and chewing CPU.
+	 *
+	 * We clear bit 3 here, as early as possible in the kernel boot (before
+	 * cpu_comm probes), preserving any READY/APP_READY bits that MIPS may
+	 * have already set. Same for the ARM flag word for symmetry.
+	 *
+	 * Flag layout (from RE): shmem + 0x4CDC = ARM flag, + 0x4CE0 = MIPS flag.
+	 * Bits: 0=READY, 1=NOT_READY, 2=APP_READY, 3=NOTICE_REQ (== RESET).
+	 */
+	{
+		void __iomem *flags;
+
+		flags = ioremap(CPU_COMM_SHMEM_ADDR + 0x4CDC, 8);
+		if (flags) {
+			u32 arm_flag_before  = readl(flags + 0);
+			u32 mips_flag_before = readl(flags + 4);
+
+			/* Only touch bit 3 — leave READY/APP_READY intact. */
+			writel(mips_flag_before & ~BIT(3), flags + 4);
+			writel(arm_flag_before  & ~BIT(3), flags + 0);
+
+			dev_info(&pdev->dev,
+				 "flags NOTICE_REQ cleared: ARM 0x%08x->0x%08x, MIPS 0x%08x->0x%08x\n",
+				 arm_flag_before, readl(flags + 0),
+				 mips_flag_before, readl(flags + 4));
+			iounmap(flags);
+		} else {
+			dev_warn(&pdev->dev,
+				 "failed to ioremap shmem flags — NOTICE_REQ not cleared\n");
+		}
+	}
+
+	/* Map MIPS memory region */
+	mipsloader_dev->mem_size = MIPS_TOTAL_SIZE;
+	mipsloader_dev->mem_base = devm_ioremap(&pdev->dev, MIPS_BOOT_CODE_ADDR, 
+						mipsloader_dev->mem_size);
+	if (!mipsloader_dev->mem_base) {
+		dev_err(&pdev->dev, "Failed to map MIPS memory region\n");
+		return -ENOMEM;
+	}
+	
+	dev_info(&pdev->dev, "MIPS memory region mapped: %zu bytes at %p\n",
+		 mipsloader_dev->mem_size, mipsloader_dev->mem_base);
+	
+	/* Allocate character device number */
+	ret = alloc_chrdev_region(&devt, 0, 1, MIPSLOADER_DEVICE_NAME);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to allocate device number: %d\n", ret);
+		return ret;
+	}
+	
+	mipsloader_dev->major = MAJOR(devt);
+	
+	/* Initialize character device */
+	cdev_init(&mipsloader_dev->cdev, &mipsloader_fops);
+	mipsloader_dev->cdev.owner = THIS_MODULE;
+	
+	ret = cdev_add(&mipsloader_dev->cdev, devt, 1);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to add character device: %d\n", ret);
+		goto unregister_chrdev;
+	}
+	
+	/* Create hy300 class if it doesn't exist */
+	if (!hy300_class) {
+		hy300_class = class_create("hy300");
+		if (IS_ERR(hy300_class)) {
+			ret = PTR_ERR(hy300_class);
+			dev_err(&pdev->dev, "Failed to create hy300 class: %d\n", ret);
+			hy300_class = NULL;
+			goto del_cdev;
+		}
+	}
+	
+	/* Create device class */
+	mipsloader_dev->class = class_create(MIPSLOADER_CLASS_NAME);
+	if (IS_ERR(mipsloader_dev->class)) {
+		ret = PTR_ERR(mipsloader_dev->class);
+		dev_err(&pdev->dev, "Failed to create device class: %d\n", ret);
+		goto del_cdev;
+	}
+	
+	/* Create device node */
+	mipsloader_dev->device = device_create_with_groups(mipsloader_dev->class, &pdev->dev,
+					       devt, mipsloader_dev, mipsloader_groups, MIPSLOADER_DEVICE_NAME);
+	if (IS_ERR(mipsloader_dev->device)) {
+		ret = PTR_ERR(mipsloader_dev->device);
+		dev_err(&pdev->dev, "Failed to create device: %d\n", ret);
+		goto destroy_class;
+	}
+	
+	/* Create additional device node in hy300 class for metrics */
+	if (hy300_class) {
+		struct device *metrics_dev = device_create_with_groups(hy300_class, &pdev->dev,
+							MKDEV(0, 0), mipsloader_dev, mipsloader_groups, "mips");
+		if (IS_ERR(metrics_dev)) {
+			dev_warn(&pdev->dev, "Failed to create metrics device: %ld\n", PTR_ERR(metrics_dev));
+		} else {
+			dev_info(&pdev->dev, "Metrics available at /sys/class/hy300/mips/\n");
+		}
+	}
+	
+	dev_info(&pdev->dev, "MIPS loader driver initialized successfully\n");
+	dev_info(&pdev->dev, "Device node: /dev/%s\n", MIPSLOADER_DEVICE_NAME);
+
+	/* ── Start MIPS elog full capture ──────────────────────── */
+	elog_linear    = vmalloc(ELOG_CAPTURE_SIZE);
+	elog_ctl_vaddr = ioremap(ELOG_CTL_PHYS, ELOG_CTL_SIZE);
+	if (elog_linear && elog_ctl_vaddr) {
+		memset(elog_linear, 0, ELOG_CAPTURE_SIZE);
+		elog_wp          = 0;
+		elog_full        = false;
+		elog_last_wp_src = 0;
+		elog_last_wrap   = 0;
+		elog_thread = kthread_run(elog_thread_fn, NULL,
+					 "mips_elog_cap");
+		if (IS_ERR(elog_thread)) {
+			dev_warn(&pdev->dev, "elog capture thread failed: %ld\n",
+				 PTR_ERR(elog_thread));
+			elog_thread = NULL;
+		}
+	} else {
+		dev_warn(&pdev->dev, "elog capture: alloc/ioremap failed\n");
+		vfree(elog_linear); elog_linear = NULL;
+		if (elog_ctl_vaddr) { iounmap(elog_ctl_vaddr); elog_ctl_vaddr = NULL; }
+	}
+
+	return 0;
+
+destroy_class:
+	class_destroy(mipsloader_dev->class);
+del_cdev:
+	cdev_del(&mipsloader_dev->cdev);
+unregister_chrdev:
+	unregister_chrdev_region(devt, 1);
+	
+	return ret;
+}
+
+/**
+ * mipsloader_remove - Platform device remove
+ */
+static void mipsloader_remove(struct platform_device *pdev)
+{
+	struct mipsloader_device *dev = platform_get_drvdata(pdev);
+	dev_t devt = MKDEV(dev->major, 0);
+	
+	dev_info(&pdev->dev, "Removing MIPS loader device\n");
+
+	/* Stop elog capture */
+	if (elog_thread) {
+		kthread_stop(elog_thread);
+		elog_thread = NULL;
+	}
+	vfree(elog_linear); elog_linear = NULL;
+	if (elog_ctl_vaddr) { iounmap(elog_ctl_vaddr); elog_ctl_vaddr = NULL; }
+
+	/* Remove metrics device from hy300 class */
+	if (hy300_class) {
+		device_destroy(hy300_class, MKDEV(0, 0));
+		/* Note: Not destroying hy300_class as other drivers may use it */
+	}
+	
+	/* Cleanup device */
+	device_destroy(dev->class, devt);
+	class_destroy(dev->class);
+	cdev_del(&dev->cdev);
+	unregister_chrdev_region(devt, 1);
+	
+	/* Power down MIPS if running */
+	if (dev->firmware_loaded) {
+		mipsloader_powerdown();
+	}
+	
+	mipsloader_dev = NULL;
+	
+	dev_info(&pdev->dev, "MIPS loader driver removed\n");
+}
+
+static const struct of_device_id mipsloader_of_match[] = {
+	{ .compatible = "allwinner,sunxi-mipsloader" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mipsloader_of_match);
+
+static struct platform_driver mipsloader_driver = {
+	.probe = mipsloader_probe,
+	.remove = mipsloader_remove,
+	.driver = {
+		.name = "sunxi-mipsloader",
+		.of_match_table = mipsloader_of_match,
+	},
+};
+
+module_platform_driver(mipsloader_driver);
+
+MODULE_AUTHOR("HY300 Linux Porting Project");
+MODULE_DESCRIPTION("Allwinner MIPS Co-processor Loader Driver");
+MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:sunxi-mipsloader");
