+#define H713_HDMI_RX_DEFAULT_EDID_FW	"hy310-edid.bin"
+#define H713_HDMI_RX_EDID_DDC_ADDR	0x50
+#define H713_HDMI_RX_EDID_MAX_LEN	512   /* up to 4 blocks */
+
+/* Synopsys DW-HDMI-RX register offsets within thdmirx_base (0x050c0000),
+ * ported from drivers/media/platform/synopsys/hdmirx/snps_hdmirx.h.
+ * v10 mainline-pattern init (replaces stock-display.bin-based PHY init).
+ */
+#define SNPS_GLOBAL_TIMER_REF_BASE	0x0028
+#define SNPS_CMU_CONFIG0		0x0060
+#define  TMDSQPCLK_STABLE_FREQ_MARGIN_MASK	GENMASK(30, 16)
+#define  TMDSQPCLK_STABLE_FREQ_MARGIN(x)	(((x) << 16) & GENMASK(30, 16))
+#define  AUDCLK_STABLE_FREQ_MARGIN_MASK		GENMASK(11, 9)
+#define  AUDCLK_STABLE_FREQ_MARGIN(x)		(((x) << 9) & GENMASK(11, 9))
+#define SNPS_PHY_CONFIG			0x00c0
+#define  PHY_CONFIG_TMDS_CLOCK_RATIO	BIT(16)
+#define  PHY_CONFIG_RXDATA_WIDTH	BIT(15)
+#define  PHY_CONFIG_REFFREQ_SEL_MASK	GENMASK(11, 9)
+#define  PHY_CONFIG_REFFREQ_SEL(x)	(((x) << 9) & GENMASK(11, 9))
+#define  PHY_CONFIG_HDMI_DISABLE	BIT(8)
+#define  PHY_CONFIG_PHY_PDDQ		BIT(1)
+#define  PHY_CONFIG_PHY_RESET		BIT(0)
+#define SNPS_PHY_STATUS			0x00c8
+#define SNPS_I2C_SLAVE_CONFIG1		0x0164
+#define  I2C_SDA_OUT_HOLD_VALUE_QST_MASK	GENMASK(15, 8)
+#define  I2C_SDA_OUT_HOLD_VALUE_QST(x)		(((x) << 8) & GENMASK(15, 8))
+#define  I2C_SDA_IN_HOLD_VALUE_QST_MASK		GENMASK(7, 0)
+#define  I2C_SDA_IN_HOLD_VALUE_QST(x)		((x) & GENMASK(7, 0))
+#define SNPS_DESCRAND_EN_CONTROL	0x0210
+#define  SCRAMB_EN_SEL_QST_MASK		GENMASK(1, 0)
+#define  SCRAMB_EN_SEL_QST(x)		((x) & GENMASK(1, 0))
+#define SNPS_DEFRAMER_CONFIG0		0x0270
+#define  VS_REMAPFILTER_EN_QST		BIT(8)
+#define  VS_FILTER_ORDER_QST_MASK	GENMASK(1, 0)
+#define  VS_FILTER_ORDER_QST(x)		((x) & GENMASK(1, 0))
+#define SNPS_HDCP2_CONFIG		0x02f0
+#define  HDCP2_SWITCH_OVR_VALUE		BIT(2)
+#define  HDCP2_SWITCH_OVR_EN		BIT(1)
+#define SNPS_SCDC_REGBANK_CONFIG0	0x05c0
+#define  SCDC_SINKVERSION_QST_MASK	GENMASK(7, 0)
+#define  SCDC_SINKVERSION_QST(x)	((x) & GENMASK(7, 0))
+#define SNPS_SCDC_REGBANK_STATUS1	0x0808
+#define  SCDC_TMDSBITCLKRATIO		BIT(1)
+#define SNPS_CED_CONFIG			0x0760
+#define  CED_VIDDATACHECKEN_QST		BIT(27)
+#define  CED_DATAISCHECKEN_QST		BIT(26)
+#define  CED_GBCHECKEN_QST		BIT(25)
+#define  CED_CTRLCHECKEN_QST		BIT(24)
+#define  CED_CHLOCKMAXER_QST_MASK	GENMASK(14, 0)
+#define  CED_CHLOCKMAXER_QST(x)		((x) & GENMASK(14, 0))
+#define SNPS_MAINUNIT_0_INT_CLEAR	0x5018
+#define SNPS_MAINUNIT_0_INT_MASK_N	0x5014
+#define  TIMER_BASE_LOCKED_IRQ		BIT(26)
+
+/*
+ * Physical HPD-pin control register on H713.
+ *
+ * 0x07091014 lives in the SoC's CPUS/RTC-domain register block (outside
+ * the RTC declared range, undocumented). Reverse-engineered from the
+ * stock ARISC firmware HPD-handler at 0x121e4 — it writes a 3-bit field
+ * here where each bit represents one HDMI-RX port (bit N = port N HPD).
+ * Bits 3..31 are read-only zero (writes are masked).
+ *
+ * Live-verified 2026-04-28 (manual reproduction):
+ *   1. force register = 0x00 (all 3 ports HPD low)
+ *   2. hold for several seconds (the source needs a long enough LOW
+ *      level to invalidate its "no display" cache — a short flicker
+ *      does NOT trigger re-detection, only a sustained LOW)
+ *   3. write 0xFF → register reads back 0x07 (all 3 ports HPD high)
+ *      → source-side sees the long LOW→HIGH edge, re-reads EDID via
+ *      DDC, and detects HY310 as the configured display.
+ *
+ * Driver implements this by clearing all bits in controller_enable()
+ * (which runs at probe ~0.9 s) and re-asserting all bits after the
+ * EDID firmware load succeeds (delayed_work callback ~5–10 s later).
+ * The natural multi-second gap between those two phases supplies the
+ * required sustained-LOW interval.
+ */
+#define H713_HPD_BASE			0x07091000
+#define H713_HPD_BASE_SIZE		0x100
+#define H713_HPD_PORT_MASK_REG		0x14   /* offset within base */
+#define H713_HPD_ALL_PORTS_MASK		0x07   /* bits 0,1,2 = ports 0,1,2 */
+
+/*
+ * ====================================================================
+ * THDMIRX (0x050c0000) — Synopsys DesignWare HDMI-RX compatible block.
+ * Used for DDC/EDID-RAM/HDCP. EDID-write goes through DMA_CONFIG10/11.
+ * ====================================================================
+ */
+#define THDMIRX_GLOBAL_SWRESET_REQUEST	0x0020
+#define THDMIRX_GLOBAL_SWENABLE		0x0024
+#define  THDMIRX_PHYCTRL_ENABLE		BIT(21)
+#define  THDMIRX_TMDS_ENABLE		BIT(13)
+#define  THDMIRX_DATAPATH_ENABLE	BIT(12)
+#define  THDMIRX_PKTFIFO_ENABLE		BIT(11)
+#define  THDMIRX_AVPUNIT_ENABLE		BIT(8)
+#define  THDMIRX_MAIN_ENABLE		BIT(0)
+#define THDMIRX_CMU_STATUS		0x007c
+#define  THDMIRX_TMDSQPCLK_LOCKED_ST	BIT(4)
+#define THDMIRX_PHY_CONFIG		0x00c0
+#define  THDMIRX_PHY_TMDS_CLOCK_RATIO	BIT(16)
+#define  THDMIRX_PHY_RXDATA_WIDTH	BIT(15)
+#define  THDMIRX_PHY_HDMI_DISABLE	BIT(8)
+#define  THDMIRX_PHY_PDDQ		BIT(1)
+#define  THDMIRX_PHY_RESET		BIT(0)
+#define THDMIRX_PHY_STATUS		0x00c8
+#define  THDMIRX_PHY_HDMI_DISABLE_ACK	BIT(1)
+#define  THDMIRX_PHY_PDDQ_ACK		BIT(0)
+#define THDMIRX_PHYCREG_CONFIG0		0x00e0
+#define THDMIRX_PHYCREG_CONFIG1		0x00e4
+#define THDMIRX_PHYCREG_CONFIG2		0x00e8
+#define THDMIRX_PHYCREG_CONTROL		0x00f0
+#define  THDMIRX_PHYCREG_CR_PARA_WRITE_P  BIT(1)
+#define THDMIRX_DEFRAMER_STATUS		0x027c
+#define THDMIRX_SCDC_CONFIG		0x0300
+#define  THDMIRX_HPDLOW			BIT(1)
+#define THDMIRX_MAINUNIT_2_INT_STATUS	0x5030
+#define THDMIRX_MAINUNIT_2_INT_CLEAR	0x5038
+#define  THDMIRX_PHYCREG_CR_WRITE_DONE	BIT(10)
+#define THDMIRX_SCDC_REGBANK_STATUS1	0x0808
+#define  THDMIRX_SCDC_TMDSBITCLKRATIO	BIT(1)
+
+/* SNPS PHY-internal register addresses (accessed via PHYCREG_CONFIG1/2) */
+#define SNPS_SUP_DIG_ANA_CREGS_SUP_ANA_NC	0x004f
+#define SNPS_CDR_SETTING_3_REG			0x20e9
+#define  SNPS_CDR_SETTING_BOUNDARY_3_DEFAULT	0x52da
+#define SNPS_CDR_SETTING_4_REG			0x20ea
+#define  SNPS_CDR_SETTING_BOUNDARY_4_DEFAULT	0x43cd
+#define SNPS_CDR_SETTING_5_REG			0x20eb
+#define  SNPS_CDR_SETTING_BOUNDARY_5_DEFAULT	0x35b3
+#define SNPS_CDR_SETTING_6_REG			0x20fb
+#define  SNPS_CDR_SETTING_BOUNDARY_6_DEFAULT	0x2799
+#define SNPS_CDR_SETTING_7_REG			0x20fc
+#define  SNPS_CDR_SETTING_BOUNDARY_7_DEFAULT	0x1b65
+
+/* EDID write port + control. EDID is loaded byte-by-byte through
+ * DMA_CONFIG10 while DMA_CONFIG11 selects WRITE-mode and the 7-bit DDC
+ * slave address (= 0x50 for the standard EDID slot).
+ */
+#define THDMIRX_DMA_CONFIG10		0x4424
+#define THDMIRX_DMA_CONFIG11		0x4428
+#define  THDMIRX_EDID_READ_EN_MASK	BIT(8)
+#define  THDMIRX_EDID_READ_EN(x)	(((x) & 1) << 8)
+#define  THDMIRX_EDID_WRITE_EN_MASK	BIT(7)
+#define  THDMIRX_EDID_WRITE_EN(x)	(((x) & 1) << 7)
+#define  THDMIRX_EDID_SLAVE_ADDR_MASK	GENMASK(6, 0)
+#define  THDMIRX_EDID_SLAVE_ADDR(x)	((x) & 0x7f)
+#define THDMIRX_DMA_STATUS14		0x4464
+
+/* HDMI RX Controller registers */
+#define HDMI_RX_SYS_CTRL		0x000
+#define HDMI_RX_INT_CTRL		0x004
+#define HDMI_RX_INT_STATUS		0x008
+#define HDMI_RX_HPD_STATUS		0x040
+#define HDMI_RX_TMDS_STATUS		0x044
+#define HDMI_RX_EDID_CTRL		0x050
+#define HDMI_RX_EDID_DATA		0x054
+#define HDMI_RX_DDC_CTRL		0x060
+#define HDMI_RX_DDC_STATUS		0x064
+
+#define HDMI_RX_HPD_CONNECTED		BIT(0)
+#define HDMI_RX_TMDS_LOCKED		BIT(0)
+#define HDMI_RX_DDC_DONE		BIT(0)
+#define HDMI_RX_DDC_ERROR		BIT(1)
+
+/*
+ * ====================================================================
+ * H713 HDMI RX Driver State
+ * ====================================================================
+ */
+struct h713_hdmi_rx {
+	struct device		*dev;
+	struct drm_bridge	bridge;
+	struct drm_connector	connector;
+	struct edid		*edid;
+
+	/* MMIO regions */
+	void __iomem		*rx_base;
+	void __iomem		*thdmirx_base;
+
+	/* Clocks */
+	struct clk		*clk_bus;
+	struct clk		*clk_mod;
+	struct clk		*clk_tmds;
+
+	/* Resets */
+	struct reset_control	*rst_ctrl;
+	struct reset_control	*rst_phy;
+
+	/* IRQ */
+	int			irq;
+
+	/* State */
+	bool			hpd_connected;
+	bool			tmds_locked;
+	u32			pixel_clock;
+
+	/* Async EDID-firmware load. The kernel's direct firmware loader
+	 * fails at probe (~0.9s) because the rootfs isn't mounted yet, and
+	 * request_firmware_nowait does not auto-retry — its callback fires
+	 * once with fw=NULL the moment the direct load fails. We schedule
+	 * a delayed_work that retries every 2s until success or timeout.
+	 */
+	struct delayed_work	edid_load_work;
+	unsigned int		edid_load_attempt;
+	bool			edid_loaded;
+
+	/* Physical HPD-pin control window. ioremap'ed at probe; cleared at
+	 * controller_enable() and re-asserted after the EDID load succeeds.
+	 */
+	void __iomem		*hpd_base;
+	void __iomem		*wrapper_base;
+};
+
+/* Forward decls for HPD helpers used inside controller_enable() and the
+ * EDID delayed_work callback.
+ */
+static void h713_hdmi_rx_hpd_set_all(struct h713_hdmi_rx *hdmi, bool high);
+
+#define H713_HDMI_RX_EDID_RETRY_DELAY_MS	2000
+#define H713_HDMI_RX_EDID_MAX_ATTEMPTS		30  /* ~60 s total */
+
+static inline struct h713_hdmi_rx *
+bridge_to_h713_hdmi_rx(struct drm_bridge *bridge)
+{
+	return container_of(bridge, struct h713_hdmi_rx, bridge);
+}
+
+static inline struct h713_hdmi_rx *
+connector_to_h713_hdmi_rx(struct drm_connector *connector)
+{
+	return container_of(connector, struct h713_hdmi_rx, connector);
+}
+
+/*
+ * ====================================================================
+ * HDMI RX Controller Register Access
+ * ====================================================================
+ */
+static void h713_hdmi_rx_write(struct h713_hdmi_rx *hdmi, u32 offset, u32 val)
+{
+	writel(val, hdmi->rx_base + offset);
+	dsb(sy);
+}
+
+static u32 h713_hdmi_rx_read(struct h713_hdmi_rx *hdmi, u32 offset)
+{
+	u32 val = readl(hdmi->rx_base + offset);
+	dsb(sy);
+	return val;
+}
+
+/*
+ * ====================================================================
+ * THDMIRX Register Access (0x050c0000) — Synopsys DW-HDMI-RX
+ * Used for EDID-RAM, HPD assertion, controller enable bits.
+ * ====================================================================
+ */
+static void h713_thdmirx_write(struct h713_hdmi_rx *hdmi, u32 offset, u32 val)
+{
+	writel(val, hdmi->thdmirx_base + offset);
+	dsb(sy);
+}
+
+static u32 h713_thdmirx_read(struct h713_hdmi_rx *hdmi, u32 offset)
+{
+	u32 val = readl(hdmi->thdmirx_base + offset);
+	dsb(sy);
+	return val;
+}
+
+static void h713_thdmirx_update_bits(struct h713_hdmi_rx *hdmi, u32 offset,
+				     u32 mask, u32 val)
+{
+	u32 reg = h713_thdmirx_read(hdmi, offset);
+
+	reg &= ~mask;
+	reg |= (val & mask);
+	h713_thdmirx_write(hdmi, offset, reg);
+}
+
+/*
+ * Session-S: SNPS PHY internal-register write helper. Polls
+ * MAINUNIT_2_INT_STATUS.PHYCREG_CR_WRITE_DONE instead of waiting on IRQ
+ * (avoids needing IRQ infrastructure / risk of IRQ storm like v10).
+ * Returns 0 on success, -ETIMEDOUT on completion-bit not set within 5ms.
+ */
+static int h713_hdmi_phy_register_write(struct h713_hdmi_rx *hdmi,
+					u32 phy_reg, u32 val)
+{
+	int i;
+
+	/* Clear any prior CR_WRITE_DONE status */
+	h713_thdmirx_write(hdmi, THDMIRX_MAINUNIT_2_INT_CLEAR,
+			   THDMIRX_PHYCREG_CR_WRITE_DONE);
+	dsb(sy);
+
+	h713_thdmirx_write(hdmi, THDMIRX_PHYCREG_CONFIG1, phy_reg);
+	h713_thdmirx_write(hdmi, THDMIRX_PHYCREG_CONFIG2, val);
+	h713_thdmirx_write(hdmi, THDMIRX_PHYCREG_CONTROL,
+			   THDMIRX_PHYCREG_CR_PARA_WRITE_P);
+	dsb(sy);
+
+	/* Poll for completion (mainline waits 20ms via IRQ; we poll 5ms) */
+	for (i = 0; i < 50; i++) {
+		u32 stat = h713_thdmirx_read(hdmi,
+					     THDMIRX_MAINUNIT_2_INT_STATUS);
+		if (stat & THDMIRX_PHYCREG_CR_WRITE_DONE) {
+			h713_thdmirx_write(hdmi, THDMIRX_MAINUNIT_2_INT_CLEAR,
+					   THDMIRX_PHYCREG_CR_WRITE_DONE);
+			return 0;
+		}
+		udelay(100);
+	}
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * ====================================================================
+ * EDID-WRITE — load a binary EDID (typically 256 bytes / 2 blocks) into
+ * the HDMI-RX EDID-RAM via the Synopsys DMA_CONFIG10/11 register pair.
+ *
+ * Sequence (mainline snps_hdmirx pattern):
+ *   1. Set WRITE_EN=1, READ_EN=0, slave-addr=0x50 in DMA_CONFIG11.
+ *   2. Stream every byte through DMA_CONFIG10 (write-only port, the HW
+ *      auto-increments the EDID-RAM index on each access).
+ *   3. Reset both enable bits to 0 so the source-side DDC reads succeed.
+ *
+ * After this call returns, the source (laptop) reading the DDC EDID slave
+ * will receive the bytes we just wrote.
+ * ====================================================================
+ */
+static int h713_hdmi_rx_write_edid(struct h713_hdmi_rx *hdmi,
+				   const u8 *edid, size_t len)
+{
+	size_t i;
+
+	if (!hdmi->thdmirx_base) {
+		dev_err(hdmi->dev, "thdmirx region not mapped\n");
+		return -ENODEV;
+	}
+	if (!edid || !len) {
+		dev_err(hdmi->dev, "invalid EDID buffer\n");
+		return -EINVAL;
+	}
+	if (len > H713_HDMI_RX_EDID_MAX_LEN) {
+		dev_err(hdmi->dev, "EDID too large (%zu > %d)\n",
+			len, H713_HDMI_RX_EDID_MAX_LEN);
+		return -EINVAL;
+	}
+
+	/* Drop HPD low while we reload EDID — source must re-read after
+	 * we re-assert HPD. SCDC_CONFIG.HPDLOW = 1 forces low.
+	 */
+	h713_thdmirx_update_bits(hdmi, THDMIRX_SCDC_CONFIG,
+				 THDMIRX_HPDLOW, THDMIRX_HPDLOW);
+
+	/* Enter WRITE mode on slave 0x50 */
+	h713_thdmirx_update_bits(hdmi, THDMIRX_DMA_CONFIG11,
+				 THDMIRX_EDID_READ_EN_MASK |
+				 THDMIRX_EDID_WRITE_EN_MASK |
+				 THDMIRX_EDID_SLAVE_ADDR_MASK,
+				 THDMIRX_EDID_READ_EN(0) |
+				 THDMIRX_EDID_WRITE_EN(1) |
+				 THDMIRX_EDID_SLAVE_ADDR(H713_HDMI_RX_EDID_DDC_ADDR));
+
+	/* Byte-by-byte stream — DMA_CONFIG10 is the EDID-RAM write port. */
+	for (i = 0; i < len; i++)
+		h713_thdmirx_write(hdmi, THDMIRX_DMA_CONFIG10, edid[i]);
+
+	/* Drop both enable bits so the source-side DDC reads pass through.
+	 * Slave-address stays parked at 0x50.
+	 */
+	h713_thdmirx_update_bits(hdmi, THDMIRX_DMA_CONFIG11,
+				 THDMIRX_EDID_READ_EN_MASK |
+				 THDMIRX_EDID_WRITE_EN_MASK,
+				 THDMIRX_EDID_READ_EN(0) |
+				 THDMIRX_EDID_WRITE_EN(0));
+
+	/* Re-assert HPD so the source notices "display ready" and re-reads. */
+	h713_thdmirx_update_bits(hdmi, THDMIRX_SCDC_CONFIG,
+				 THDMIRX_HPDLOW, 0);
+
+	dev_info(hdmi->dev, "loaded %zu bytes of EDID into HDMI-RX EDID-RAM\n",
+		 len);
+	return 0;
+}
+
+/*
+ * Drive (or release) all HDMI-RX HPD ports through the undocumented
+ * 0x07091014 register. Writing 0 forces HPD low on every port; writing
+ * 0xFF (which the HW masks down to 0x07 = bits 0,1,2) drives HPD high
+ * on all ports. Source-side latches on the LOW→HIGH edge after a
+ * sufficiently long LOW interval — see register documentation above.
+ */
+static void h713_hdmi_rx_hpd_set_all(struct h713_hdmi_rx *hdmi, bool high)
+{
+	if (!hdmi->hpd_base)
+		return;
+
+	writel(high ? H713_HPD_ALL_PORTS_MASK : 0,
+	       hdmi->hpd_base + H713_HPD_PORT_MASK_REG);
+	dsb(sy);
+}
+
+/*
+ * Try a single firmware_request_nowarn attempt. Returns 0 if the EDID
+ * was successfully written to the HDMI-RX EDID-RAM, or a negative errno
+ * (typically -ENOENT while the rootfs is not yet mounted).
+ */
+static int h713_hdmi_rx_try_load_edid(struct h713_hdmi_rx *hdmi)
+{
+	const struct firmware *fw;
+	int ret;
+
+	ret = firmware_request_nowarn(&fw, H713_HDMI_RX_DEFAULT_EDID_FW,
+				      hdmi->dev);
+	if (ret)
+		return ret;
+
+	if (fw->size < 128 || (fw->size & 0x7f)) {
+		dev_err(hdmi->dev,
+			"EDID firmware '%s' has invalid size %zu (must be multiple of 128, >=128)\n",
+			H713_HDMI_RX_DEFAULT_EDID_FW, fw->size);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (fw->data[0] != 0x00 || fw->data[7] != 0x00 ||
+	    fw->data[1] != 0xff || fw->data[6] != 0xff) {
+		dev_warn(hdmi->dev,
+			 "EDID firmware lacks VESA magic header — loading anyway\n");
+	}
+
+	ret = h713_hdmi_rx_write_edid(hdmi, fw->data, fw->size);
+
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+/*
+ * Delayed-work retry loop. Reschedules itself every 2 seconds until the
+ * firmware load succeeds or H713_HDMI_RX_EDID_MAX_ATTEMPTS is exhausted.
+ * We have to retry because probe runs ~0.9 s into boot, well before
+ * /lib/firmware on the rootfs becomes readable.
+ */
+static void h713_hdmi_rx_edid_load_work(struct work_struct *work)
+{
+	struct h713_hdmi_rx *hdmi = container_of(to_delayed_work(work),
+						 struct h713_hdmi_rx,
+						 edid_load_work);
+	int ret;
+
+	if (hdmi->edid_loaded)
+		return;
+
+	hdmi->edid_load_attempt++;
+
+	ret = h713_hdmi_rx_try_load_edid(hdmi);
+	if (!ret) {
+		hdmi->edid_loaded = true;
+		dev_info(hdmi->dev,
+			 "EDID firmware load succeeded on attempt %u\n",
+			 hdmi->edid_load_attempt);
+
+		/* EDID-RAM is loaded — drive HPD HIGH on all ports. The
+		 * controller has been holding HPD LOW since probe (~5–10 s
+		 * ago), which is sustained enough to invalidate the source's
+		 * "no display" cache. The LOW→HIGH transition is what
+		 * triggers re-detection and a fresh EDID read.
+		 */
+		h713_hdmi_rx_hpd_set_all(hdmi, true);
+		dev_info(hdmi->dev,
+			 "HPD asserted HIGH on all ports — source should detect display\n");
+		return;
+	}
+
+	if (hdmi->edid_load_attempt < H713_HDMI_RX_EDID_MAX_ATTEMPTS) {
+		dev_dbg(hdmi->dev,
+			"EDID firmware not ready yet (attempt %u, %d) — retrying in %u ms\n",
+			hdmi->edid_load_attempt, ret,
+			H713_HDMI_RX_EDID_RETRY_DELAY_MS);
+		schedule_delayed_work(&hdmi->edid_load_work,
+			msecs_to_jiffies(H713_HDMI_RX_EDID_RETRY_DELAY_MS));
+		return;
+	}
+
+	dev_warn(hdmi->dev,
+		 "EDID firmware '%s' still unavailable after %u attempts (~%u s) — HDMI-RX EDID-RAM left unprogrammed\n",
+		 H713_HDMI_RX_DEFAULT_EDID_FW,
+		 H713_HDMI_RX_EDID_MAX_ATTEMPTS,
+		 (H713_HDMI_RX_EDID_MAX_ATTEMPTS *
+		  H713_HDMI_RX_EDID_RETRY_DELAY_MS) / 1000);
+}
+
+/*
+ * Kick the delayed-work retry loop. Returns 0 — the actual load happens
+ * asynchronously and the probe path doesn't depend on its outcome.
+ */
+static int h713_hdmi_rx_load_default_edid(struct h713_hdmi_rx *hdmi)
+{
+	INIT_DELAYED_WORK(&hdmi->edid_load_work, h713_hdmi_rx_edid_load_work);
+	hdmi->edid_load_attempt = 0;
+	hdmi->edid_loaded = false;
+	schedule_delayed_work(&hdmi->edid_load_work, 0);
+	return 0;
+}
+
+/*
+ * ====================================================================
+ * HPD (Hot Plug Detect) and TMDS Status
+ * ====================================================================
+ */
+static bool h713_hdmi_rx_check_hpd(struct h713_hdmi_rx *hdmi)
+{
+	u32 status = h713_hdmi_rx_read(hdmi, HDMI_RX_HPD_STATUS);
+	hdmi->hpd_connected = !!(status & HDMI_RX_HPD_CONNECTED);
+	return hdmi->hpd_connected;
+}
+
+static bool h713_hdmi_rx_check_tmds(struct h713_hdmi_rx *hdmi)
+{
+	u32 status = h713_hdmi_rx_read(hdmi, HDMI_RX_TMDS_STATUS);
+	hdmi->tmds_locked = !!(status & HDMI_RX_TMDS_LOCKED);
+	return hdmi->tmds_locked;
+}
+
+/*
+ * ====================================================================
+ * EDID Reading via DDC
+ * ====================================================================
+ */
+static int h713_hdmi_rx_read_edid_block(struct h713_hdmi_rx *hdmi,
+					u8 *buf, int block, int segment)
+{
+	int i;
+
+	h713_hdmi_rx_write(hdmi, HDMI_RX_EDID_CTRL, segment);
+	h713_hdmi_rx_write(hdmi, HDMI_RX_DDC_CTRL,
+			   (0x50 << 1) | (block & 0xff) | BIT(0));
+
+	for (i = 0; i < 1000; i++) {
+		u32 status = h713_hdmi_rx_read(hdmi, HDMI_RX_DDC_STATUS);
+		if (status & HDMI_RX_DDC_DONE)
+			break;
+		if (status & HDMI_RX_DDC_ERROR) {
+			dev_err(hdmi->dev, "DDC read error\n");
+			return -EIO;
+		}
+		usleep_range(100, 200);
+	}
+
+	if (i == 1000) {
+		dev_err(hdmi->dev, "DDC read timeout\n");
+		return -ETIMEDOUT;
+	}
+
+	for (i = 0; i < 128; i += 4) {
+		u32 data = h713_hdmi_rx_read(hdmi, HDMI_RX_EDID_DATA);
+		buf[i + 0] = data & 0xff;
+		buf[i + 1] = (data >> 8) & 0xff;
+		buf[i + 2] = (data >> 16) & 0xff;
+		buf[i + 3] = (data >> 24) & 0xff;
+	}
+
+	return 0;
+}
+
+static struct edid *h713_hdmi_rx_get_edid(struct h713_hdmi_rx *hdmi)
+{
+	struct edid *edid;
+	int ret;
+
+	edid = kmalloc(EDID_LENGTH, GFP_KERNEL);
+	if (!edid)
+		return NULL;
+
+	ret = h713_hdmi_rx_read_edid_block(hdmi, (u8 *)edid, 0, 0);
+	if (ret) {
+		kfree(edid);
+		return NULL;
+	}
+
+	if (!drm_edid_is_valid(edid)) {
+		dev_warn(hdmi->dev, "Invalid EDID\n");
+		kfree(edid);
+		return NULL;
+	}
+
+	return edid;
+}
+
+/* Forward declarations — connector_funcs defined further down. */
+static const struct drm_connector_funcs h713_hdmi_rx_connector_funcs;
+
+/*
+ * ====================================================================
+ * Controller bring-up — minimum viable HDMI-RX power-on sequence.
+ *
+ * For the HY310 use-case the source (laptop) only needs a working DDC
+ * slave on 0x50 plus an asserted HPD line. The full TMDS-decode path
+ * (PHY + deframer + capture) is not required until we wire up a media
+ * graph to TVCAP, so this routine intentionally stops at AVPUNIT-level.
+ * ====================================================================
+ */
+static int h713_hdmi_rx_controller_enable(struct h713_hdmi_rx *hdmi)
+{
+	u32 val;
+
+	if (!hdmi->thdmirx_base)
+		return -ENODEV;
+
+	/* H713 wrapper: writable per-port state */
+	if (hdmi->wrapper_base) {
+		writeb(0x00, hdmi->wrapper_base + 0x40202);
+		writeb(0x00, hdmi->wrapper_base + 0x40210);
+		writeb(0x00, hdmi->wrapper_base + 0x40220);
+		writeb(0x00, hdmi->wrapper_base + 0x40221);
+		writeb(0x00, hdmi->wrapper_base + 0x40230);
+		writeb(0x00, hdmi->wrapper_base + 0x40240);
+		writeb(0x00, hdmi->wrapper_base + 0x402C0);
+		writeb(0x00, hdmi->wrapper_base + 0x40137);
+		writeb(0x00, hdmi->wrapper_base + 0x400C0);
+		writeb(0x00, hdmi->wrapper_base + 0x00);
+	}
+
+	/* Mask all interrupts */
+	h713_thdmirx_write(hdmi, SNPS_MAINUNIT_0_INT_MASK_N, 0xFFFFFFFF);
+	h713_thdmirx_write(hdmi, SNPS_MAINUNIT_0_INT_CLEAR, 0xFFFFFFFF);
+
+	/* TIMER_REF_BASE */
+	h713_thdmirx_write(hdmi, SNPS_GLOBAL_TIMER_REF_BASE, 428571429);
+	udelay(10);
+
+	/* CMU_CONFIG0 margins */
+	val = h713_thdmirx_read(hdmi, SNPS_CMU_CONFIG0);
+	val &= ~(TMDSQPCLK_STABLE_FREQ_MARGIN_MASK | AUDCLK_STABLE_FREQ_MARGIN_MASK);
+	val |= TMDSQPCLK_STABLE_FREQ_MARGIN(2) | AUDCLK_STABLE_FREQ_MARGIN(1);
+	h713_thdmirx_write(hdmi, SNPS_CMU_CONFIG0, val);
+
+	/* DESCRAND_EN */
+	val = h713_thdmirx_read(hdmi, SNPS_DESCRAND_EN_CONTROL);
+	val &= ~SCRAMB_EN_SEL_QST_MASK;
+	val |= SCRAMB_EN_SEL_QST(1);
+	h713_thdmirx_write(hdmi, SNPS_DESCRAND_EN_CONTROL, val);
+
+	/* CED_CONFIG */
+	val = h713_thdmirx_read(hdmi, SNPS_CED_CONFIG);
+	val &= ~CED_CHLOCKMAXER_QST_MASK;
+	val |= CED_VIDDATACHECKEN_QST | CED_GBCHECKEN_QST | CED_CTRLCHECKEN_QST |
+	       CED_CHLOCKMAXER_QST(0x10);
+	h713_thdmirx_write(hdmi, SNPS_CED_CONFIG, val);
+
+	/* DEFRAMER_CONFIG0 */
+	val = h713_thdmirx_read(hdmi, SNPS_DEFRAMER_CONFIG0);
+	val &= ~VS_FILTER_ORDER_QST_MASK;
+	val |= VS_REMAPFILTER_EN_QST | VS_FILTER_ORDER_QST(0x3);
+	h713_thdmirx_write(hdmi, SNPS_DEFRAMER_CONFIG0, val);
+
+	/* PHY_CONFIG from SCDC detect */
+	{
+		u32 scdc_st1 = h713_thdmirx_read(hdmi, THDMIRX_SCDC_REGBANK_STATUS1);
+		bool high_rate = (scdc_st1 & THDMIRX_SCDC_TMDSBITCLKRATIO) != 0;
+		u32 phy_cfg = THDMIRX_PHY_RXDATA_WIDTH;
+
+		if (high_rate)
+			phy_cfg |= THDMIRX_PHY_TMDS_CLOCK_RATIO;
+
+		h713_thdmirx_write(hdmi, THDMIRX_PHY_CONFIG, phy_cfg);
+		dsb(sy);
+
+		dev_info(hdmi->dev,
+			 "Session-U: PHY_CONFIG=0x%x (high_rate=%d, scdc_st1=0x%x)\n",
+			 phy_cfg, high_rate, scdc_st1);
+	}
+
+	/* Full SWENABLE */
+	h713_thdmirx_write(hdmi, THDMIRX_GLOBAL_SWENABLE,
+			   THDMIRX_MAIN_ENABLE | THDMIRX_AVPUNIT_ENABLE |
+			   THDMIRX_PKTFIFO_ENABLE | THDMIRX_DATAPATH_ENABLE |
+			   THDMIRX_TMDS_ENABLE | THDMIRX_PHYCTRL_ENABLE);
+
+	dev_info(hdmi->dev,
+		 "Session-U: full Synopsys init done (SWENABLE=0x3B01)\n");
+
+	/* HPD low until EDID loaded */
+	h713_hdmi_rx_hpd_set_all(hdmi, false);
+	h713_thdmirx_update_bits(hdmi, THDMIRX_SCDC_CONFIG,
+				 THDMIRX_HPDLOW, THDMIRX_HPDLOW);
+
+	dev_info(hdmi->dev,
+		 "Session-U: HPD low, waiting for MIPS init + EDID load\n");
+
+	return 0;
+}
+/*
+ * ====================================================================
+ * DRM Bridge Operations
+ * ====================================================================
+ */
+static int h713_hdmi_rx_bridge_attach(struct drm_bridge *bridge,
+				      struct drm_encoder *encoder,
+				      enum drm_bridge_attach_flags flags)
+{
+	struct h713_hdmi_rx *hdmi = bridge_to_h713_hdmi_rx(bridge);
+	int ret;
+
+	/* Connector init must run AFTER bridge.dev is set by the
+	 * downstream DRM driver — that only happens once drm_bridge_attach
+	 * has been called by the parent CRTC, which is exactly here. The
+	 * old probe-time call crashed because bridge.dev was still NULL.
+	 */
+	if (!(flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR)) {
+		ret = drm_connector_init(bridge->dev, &hdmi->connector,
+					 &h713_hdmi_rx_connector_funcs,
+					 DRM_MODE_CONNECTOR_HDMIA);
+		if (ret) {
+			dev_err(hdmi->dev,
+				"Failed to init connector: %d\n", ret);
+			return ret;
+		}
+
+		drm_connector_helper_add(&hdmi->connector, NULL);
+
+		ret = drm_connector_attach_encoder(&hdmi->connector, encoder);
+		if (ret) {
+			dev_err(hdmi->dev,
+				"Failed to attach connector: %d\n", ret);
+			drm_connector_cleanup(&hdmi->connector);
+			return ret;
+		}
+	}
+
+	dev_info(hdmi->dev, "HDMI RX bridge attached\n");
+	return 0;
+}
+
+static void h713_hdmi_rx_bridge_detach(struct drm_bridge *bridge)
+{
+}
+
+static enum drm_connector_status
+h713_hdmi_rx_bridge_detect(struct drm_bridge *bridge)
+{
+	struct h713_hdmi_rx *hdmi = bridge_to_h713_hdmi_rx(bridge);
+	bool connected;
+
+	connected = h713_hdmi_rx_check_hpd(hdmi);
+	if (connected)
+		connected = h713_hdmi_rx_check_tmds(hdmi);
+
+	return connected ? connector_status_connected :
+			   connector_status_disconnected;
+}
+
+static int
+h713_hdmi_rx_bridge_get_modes(struct drm_bridge *bridge,
+			      struct drm_connector *connector)
+{
+	struct h713_hdmi_rx *hdmi = bridge_to_h713_hdmi_rx(bridge);
+	struct edid *edid;
+	int num_modes = 0;
+
+	if (!hdmi->hpd_connected)
+		return 0;
+
+	kfree(hdmi->edid);
+	hdmi->edid = h713_hdmi_rx_get_edid(hdmi);
+	if (!hdmi->edid)
+		return 0;
+
+	edid = hdmi->edid;
+	drm_connector_update_edid_property(connector, edid);
+	num_modes = drm_add_edid_modes(connector, edid);
+
+	return num_modes;
+}
+
+static const struct drm_bridge_funcs h713_hdmi_rx_bridge_funcs = {
+	.attach = h713_hdmi_rx_bridge_attach,
+	.detach = h713_hdmi_rx_bridge_detach,
+	.detect = h713_hdmi_rx_bridge_detect,
+	.get_modes = h713_hdmi_rx_bridge_get_modes,
+};
+
+/*
+ * ====================================================================
+ * DRM Connector Operations
+ * ====================================================================
+ */
+static enum drm_connector_status
+h713_hdmi_rx_connector_detect(struct drm_connector *connector, bool force)
+{
+	struct h713_hdmi_rx *hdmi = connector_to_h713_hdmi_rx(connector);
+	return h713_hdmi_rx_bridge_detect(&hdmi->bridge);
+}
+
+static const struct drm_connector_funcs h713_hdmi_rx_connector_funcs = {
+	.detect = h713_hdmi_rx_connector_detect,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+};
+
+/*
+ * ====================================================================
+ * IRQ Handler — FIX: only called after bridge.dev is set
+ * ====================================================================
+ */
+static irqreturn_t h713_hdmi_rx_irq(int irq, void *data)
+{
+	struct h713_hdmi_rx *hdmi = data;
+	u32 status;
+
+	if (!hdmi->bridge.dev)
+		return IRQ_NONE;
+
+	status = h713_hdmi_rx_read(hdmi, HDMI_RX_INT_STATUS);
+
+	if (status & HDMI_RX_HPD_CONNECTED) {
+		hdmi->hpd_connected = true;
+		dev_info(hdmi->dev, "HDMI connected\n");
+	} else {
+		hdmi->hpd_connected = false;
+		dev_info(hdmi->dev, "HDMI disconnected\n");
+	}
+
+	drm_kms_helper_hotplug_event(hdmi->bridge.dev);
+	return IRQ_HANDLED;
+}
+
+/*
+ * ====================================================================
+ * Platform Driver
+ * ====================================================================
+ */
+static int h713_hdmi_rx_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct h713_hdmi_rx *hdmi;
+	struct resource *res;
+	int ret;
+
+	hdmi = devm_kzalloc(dev, sizeof(*hdmi), GFP_KERNEL);
+	if (!hdmi)
+		return -ENOMEM;
+
+	hdmi->dev = dev;
+	platform_set_drvdata(pdev, hdmi);
+
+	/* Map HDMI RX Controller (0x05000000) */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "rx");
+	if (!res)
+		res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	hdmi->rx_base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(hdmi->rx_base))
+		return PTR_ERR(hdmi->rx_base);
+
+	/* Map THDMIRx (0x050c0000) */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "thdmirx");
+	if (res) {
+		hdmi->thdmirx_base = devm_ioremap_resource(dev, res);
+		if (IS_ERR(hdmi->thdmirx_base))
+			return PTR_ERR(hdmi->thdmirx_base);
+	}
+
+	/* Map physical HPD-control register (0x07091000+0x100). This block
+	 * is undocumented and lives outside any DTS-declared range, so we
+	 * use a manual ioremap (no struct resource). HPD-pin sequencing is
+	 * handled by h713_hdmi_rx_hpd_set_all().
+	 */
+	hdmi->hpd_base = devm_ioremap(dev, H713_HPD_BASE, H713_HPD_BASE_SIZE);
+
+	/* Map H713 wrapper per-port state (0x06840000). Writes to byte 0x00
+	 * (TMDS reset) and the PHY_PreConfigClear range are accepted by the
+	 * hardware. Port-select (0x068008F1) and PHY-reset-ctrl (0x068008FC)
+	 * are read-only for ARM. */
+	hdmi->wrapper_base = devm_ioremap(dev, 0x06840000, 0x50000);
+	if (!hdmi->wrapper_base)
+		dev_warn(dev,
+			 "Failed to ioremap H713 wrapper @ 0x06840000\n");
+	if (!hdmi->hpd_base)
+		dev_warn(dev,
+			 "Failed to ioremap HPD ctrl @ 0x%08x — HPD will not be driven\n",
+			 H713_HPD_BASE);
+
+	/* Get clocks */
+	hdmi->clk_bus = devm_clk_get_enabled(dev, "bus");
+	if (IS_ERR(hdmi->clk_bus)) {
+		dev_err(dev, "Failed to get bus clock\n");
+		return PTR_ERR(hdmi->clk_bus);
+	}
+
+	hdmi->clk_mod = devm_clk_get_enabled(dev, "mod");
+	if (IS_ERR(hdmi->clk_mod)) {
+		dev_err(dev, "Failed to get mod clock\n");
+		return PTR_ERR(hdmi->clk_mod);
+	}
+
+	hdmi->clk_tmds = devm_clk_get(dev, "tmds");
+
+	/* Resets: BOTH "ctrl" and "phy" are optional and SHARED. On H713 the
+	 * HDMI-RX, HDMI-TX, GE2D, TVTOP, DECD blocks and the future TVCAP
+	 * pipeline all sit behind the same bus-disp reset line. If we took
+	 * it exclusive we would shut every other driver out (-EBUSY in
+	 * h713-drm / sunxi-tvtop / decd probe). Either nobody touches it
+	 * (U-Boot already deasserted bus-disp) or we share with peers via
+	 * refcount-style shared handles.
+	 *
+	 * For the EDID + HPD use-case we don't actually need the bus reset
+	 * at all — the only reset that matters is the internal soft-reset
+	 * driven via THDMIRX_GLOBAL_SWRESET_REQUEST in controller_enable().
+	 */
+	hdmi->rst_ctrl = devm_reset_control_get_optional_shared(dev, "ctrl");
+	if (IS_ERR(hdmi->rst_ctrl)) {
+		dev_err(dev, "Failed to get ctrl reset\n");
+		return PTR_ERR(hdmi->rst_ctrl);
+	}
+
+	hdmi->rst_phy = devm_reset_control_get_optional_shared(dev, "phy");
+	if (IS_ERR(hdmi->rst_phy)) {
+		dev_err(dev, "Failed to get phy reset\n");
+		return PTR_ERR(hdmi->rst_phy);
+	}
+
+	if (hdmi->rst_ctrl) {
+		ret = reset_control_deassert(hdmi->rst_ctrl);
+		if (ret) {
+			dev_err(dev, "Failed to deassert ctrl reset\n");
+			return ret;
+		}
+	}
+
+	if (hdmi->rst_phy) {
+		ret = reset_control_deassert(hdmi->rst_phy);
+		if (ret) {
+			dev_err(dev, "Failed to deassert phy reset\n");
+			goto err_assert_ctrl;
+		}
+	}
+
+	/* Bring the controller up to the level needed for DDC/EDID + HPD.
+	 * The PHY (TMDS path) stays unconfigured until a DRM consumer
+	 * actually attaches via drm_bridge_attach.
+	 */
+	ret = h713_hdmi_rx_controller_enable(hdmi);
+	if (ret) {
+		dev_err(dev, "Failed to enable controller: %d\n", ret);
+		goto err_assert_phy;
+	}
+
+	/* Pre-program the EDID-RAM with our default firmware so the source
+	 * sees a sane EDID the moment HPD goes high. Failures are non-fatal
+	 * — the controller still works and userspace can push an EDID
+	 * later via sysfs (TODO).
+	 */
+	(void)h713_hdmi_rx_load_default_edid(hdmi);
+
+	/* Register the bridge after the HW is ready. The bridge stays
+	 * dormant (no DRM device) until a parent CRTC calls
+	 * drm_bridge_attach — that's where connector_init now lives.
+	 */
+	hdmi->bridge.funcs = &h713_hdmi_rx_bridge_funcs;
+	hdmi->bridge.of_node = dev->of_node;
+	hdmi->bridge.type = DRM_MODE_CONNECTOR_HDMIA;
+	drm_bridge_add(&hdmi->bridge);
+
+	hdmi->irq = platform_get_irq(pdev, 0);
+	if (hdmi->irq > 0) {
+		ret = devm_request_irq(dev, hdmi->irq, h713_hdmi_rx_irq,
+				       0, dev_name(dev), hdmi);
+		if (ret) {
+			dev_warn(dev, "Failed to request IRQ: %d\n", ret);
+			hdmi->irq = -1;
+		}
+	}
+
+	dev_info(dev, "H713 HDMI RX driver probed successfully\n");
+	return 0;
+
+err_assert_phy:
+	if (hdmi->rst_phy)
+		reset_control_assert(hdmi->rst_phy);
+err_assert_ctrl:
+	if (hdmi->rst_ctrl)
+		reset_control_assert(hdmi->rst_ctrl);
+	return ret;
+}
+
+static void h713_hdmi_rx_remove(struct platform_device *pdev)
+{
+	struct h713_hdmi_rx *hdmi = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&hdmi->edid_load_work);
+	drm_bridge_remove(&hdmi->bridge);
+	kfree(hdmi->edid);
+
+	if (hdmi->rst_phy)
+		reset_control_assert(hdmi->rst_phy);
+	if (hdmi->rst_ctrl)
+		reset_control_assert(hdmi->rst_ctrl);
+}
+
+static const struct of_device_id h713_hdmi_rx_of_match[] = {
+	{ .compatible = "allwinner,sun50i-h713-hdmi-rx" },
+	{ .compatible = "allwinner,sun50iw12p1-hdmi-rx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, h713_hdmi_rx_of_match);
+
+static struct platform_driver h713_hdmi_rx_driver = {
+	.probe	= h713_hdmi_rx_probe,
+	.remove	= h713_hdmi_rx_remove,
+	.driver	= {
+		.name		= "h713-hdmi-rx",
+		.of_match_table	= h713_hdmi_rx_of_match,
+	},
+};
+module_platform_driver(h713_hdmi_rx_driver);
+
+MODULE_DESCRIPTION("Allwinner H713 HDMI RX Driver");
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("HY310 Project");
