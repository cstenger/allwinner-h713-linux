+const char *getCPUIDName(u32 cpu_id)
+{
+	switch (cpu_id) {
+	case CPU_ID_ARM:  return "ARM";
+	case CPU_ID_MIPS: return "MIPS";
+	default:          return "UNKNOWN";
+	}
+}
+
+u32 CPUId2Index(u32 cpu_id)
+{
+	return cpu_id; /* identity mapping on H713 */
+}
