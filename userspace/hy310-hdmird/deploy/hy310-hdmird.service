[Unit]
Description=HY310 HDMI-RX bringup daemon
Documentation=https://github.com/marco/hy310/PLAN-HY310-HDMIRD-20260501.md
# cpu_comm kernel module must be loaded first
After=systemd-modules-load.service
ConditionPathExists=/dev/cpu_comm

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'while [ ! -e /dev/cpu_comm ]; do sleep 0.1; done'
ExecStart=/usr/local/sbin/hy310-hdmird
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
# tvserver-equivalent role; needs root for /dev/cpu_comm + /dev/mem
User=root
Group=root

[Install]
WantedBy=multi-user.target
