[Unit]
Description=HY310 Picture Quality Daemon
Documentation=https://local/hy310-pqd
# Must start after /dev/cpu_comm is available (cpu_comm kernel module),
# after /dev/dri is set up (DRM driver loaded — needed for DE2 pipeline),
# and after root filesystem is writable.
After=systemd-modules-load.service local-fs.target
Wants=systemd-modules-load.service

[Service]
Type=notify-reload
ExecStart=/usr/sbin/hy310-pqd --daemon --config /etc/hy310/tvconfig -v
ExecReload=/usr/bin/hy310-pqctl apply
Restart=on-failure
RestartSec=5
# Daemon needs access to raw MMIO and /dev/cpu_comm, keep as root for now
User=root
# Hardening
ProtectSystem=strict
ReadWritePaths=/run /var/log
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
